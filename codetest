local function setupPaths()
    pcall(function()
        PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not PlayerGui then return end
        
        local topNotif = PlayerGui:FindFirstChild("TopNotification")
        if topNotif then
            Announcements = topNotif:FindFirstChild("TopNotification")
        end
        if not Announcements then
            for _, child in ipairs(PlayerGui:GetDescendants()) do
                if child:IsA("Frame") and child.Name:lower():find("announce") then
                    Announcements = child
                    break
                end
            end
        end
    end)
end

local function watchLabel(Label)
    pcall(function()
        if not Label:IsA("TextLabel") then return end
        local text = Label.Text
        if text == "" then return end
        if isProcessingSubmit then return end
        
        appendToBox(text)
    end)
end

local function startAnnouncementWatcher()
    pcall(function()
        setupPaths()
        if not Announcements then return end
        for _, v in ipairs(Announcements:GetDescendants()) do
            watchLabel(v)
        end
        Announcements.DescendantAdded:Connect(watchLabel)
    end)
end

-- SPYDERSAMMY ERKENNUNG
local function verifySourceIsSammy(TO)
    pcall(function()
        if TO:IsDescendantOf(MainFrame) then return false end
        if TO:IsDescendantOf(HelpGui) then return false end
        if TO:IsDescendantOf(SettingsFrame) then return false end
        local text = TO.Text or ""
        if text:lower():find("spydersammy") then return true end
        
        local parent = TO.Parent
        while parent do
            if parent:IsA("TextLabel") and parent.Text and parent.Text:lower():find("spydersammy") then
                return true
            end
            parent = parent.Parent
        end
    end)
    return false
end

local function handleIncomingText(TO)
    pcall(function()
        local text = TO.Text
        if text == "" then return end
        if verifySourceIsSammy(TO) then
            task.spawn(function()
                watchLabel(TO)
            end)
        end
    end)
end

local function hookUiTextObject(O)
    pcall(function()
        if O:IsA("TextLabel") then
            handleIncomingText(O)
            O:GetPropertyChangedSignal("Text"):Connect(function()
                handleIncomingText(O)
            end)
        end
    end)
end

local function startPlayerGuiScanner()
    pcall(function()
        local PG = LocalPlayer:FindFirstChild("PlayerGui")
        if not PG then return end
        for _, D in ipairs(PG:GetDescendants()) do
            hookUiTextObject(D)
        end
        PG.DescendantAdded:Connect(hookUiTextObject)
    end)
end

