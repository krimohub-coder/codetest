-- CONFIG SYSTEM
local hasFS = pcall(function() return type(writefile) == "function" end)
local function saveConfig()
    if not hasFS then return end
    pcall(function() 
        writefile("KrimoHub_config.json", HttpService:JSONEncode({
            accentColor = {r = _G.AccentColor.R, g = _G.AccentColor.G, b = _G.AccentColor.B}
        })) 
    end)
end

-- DYNAMISCHE FARBANGABE NUR FÜR RÄNDER (STROKES)
local registeredStrokes = {}
local function registerStroke(stroke)
    if stroke and stroke:IsA("UIStroke") then
        stroke.Color = _G.AccentColor
        registeredStrokes[stroke] = true
    end
end

local function setAccentColor(newColor)
    _G.AccentColor = newColor
    for stroke, _ in pairs(registeredStrokes) do
        if stroke and stroke.Parent then
            stroke.Color = newColor
        else
            registeredStrokes[stroke] = nil
        end
    end
    saveConfig()
end

-- ANCHOR LOGIK
local function setCharacterAnchored(state)
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = state
        end
    end
end

-- AUTO BUY LOGIC
local promptConnections = {}
local isAutoBuying = false
local renderConnection = nil
local addedConnection = nil

local function isValidPrompt(prompt)
    if not (prompt and prompt:IsA("ProximityPrompt")) then return false end
    local attachment = prompt.Parent
    if not attachment or attachment.Name ~= "PromptAttachment" then return false end
    local part = attachment.Parent
    if not part or part.Name ~= "Part" then return false end
    return part.Parent and part.Parent:IsA("Model") or false
end

local function getPromptPosition(prompt)
    if prompt and prompt.Parent then
        if prompt.Parent:IsA("Attachment") and prompt.Parent.Name == "PromptAttachment" and (prompt.Parent.Parent and prompt.Parent.Parent.Name == "Part") then
            return prompt.Parent.Parent.Position
        elseif prompt.Parent:IsA("BasePart") then
            return prompt.Parent.Position
        end
    end
    return nil
end

local function registerPrompt(prompt)
    if isValidPrompt(prompt) then promptConnections[prompt] = true end
end

local function startAutoBuy()
    if isAutoBuying then return end
    isAutoBuying = true
    for _, obj in ipairs(Workspace:GetDescendants()) do registerPrompt(obj) end
    
    if addedConnection then addedConnection:Disconnect() end
    addedConnection = Workspace.DescendantAdded:Connect(registerPrompt)
    
    if renderConnection then renderConnection:Disconnect() end
    renderConnection = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            for prompt, _ in pairs(promptConnections) do
                if prompt and prompt.Parent and isValidPrompt(prompt) then
                    local pos = getPromptPosition(prompt)
                    if pos and (root.Position - pos).Magnitude <= 15 then
                        pcall(function() prompt:InputHoldBegin(Enum.UserInputType.Keyboard) end)
                    else
                        pcall(function() prompt:InputHoldEnd(Enum.UserInputType.Keyboard) end)
                    end
                else
                    promptConnections[prompt] = nil
                end
            end
        end
    end)
end

local function stopAutoBuy()
    isAutoBuying = false
    if renderConnection then renderConnection:Disconnect() renderConnection = nil end
    if addedConnection then addedConnection:Disconnect() addedConnection = nil end
    for prompt, _ in pairs(promptConnections) do
        pcall(function() prompt:InputHoldEnd(Enum.UserInputType.Keyboard) end)
    end
    promptConnections = {}
end

