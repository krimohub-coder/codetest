local function hardReset()
    table.clear(buffer)
    _seen = {}
    isProcessingSubmit = false
    resetSplitBuffer()
    
    setupPaths()
    if CodeTextBox then 
        pcall(function() CodeTextBox.Text = "" end)
    end

    refreshMainGUI()
    updateTitleCounter()
end

local function hookTextBoxClearing()
    setupPaths()
    if CodeTextBox then
        CodeTextBox:GetPropertyChangedSignal("Text"):Connect(function()
            if CodeTextBox.Text == "" and #buffer > 0 then
                hardReset()
            end
        end)
    end
end

refreshMainGUI = function()
    if not MainFrame then return end
    pcall(function()
        updateTitleCounter()
        
        local ContentFrame = MainFrame:FindFirstChild("MenuPanel") and MainFrame.MenuPanel:FindFirstChild("ContentFrame")
        if not ContentFrame then return end
        
        local collectedLabel = ContentFrame:FindFirstChild("CollectedLabel")
        if collectedLabel then
            collectedLabel.Text = "🌸 Pasted: " .. #buffer .. "/" .. mode
        end
        
        local listFrame = ContentFrame:FindFirstChild("CodeListFrame")
        if not listFrame then return end
        local scroll = listFrame:FindFirstChild("Scrolling")
        if not scroll then return end
        
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextLabel") and child.Name ~= "Placeholder" then
                child:Destroy()
            end
        end
        
        local placeholder = scroll:FindFirstChild("Placeholder")
        if placeholder then
            placeholder.Visible = (#buffer == 0)
        end
        
        if #buffer > 0 then
            for i, code in ipairs(buffer) do
                if code and code ~= "" then
                    local label = Instance.new("TextLabel")
                    label.Name = "CodeEntry"
                    label.Size = UDim2.new(1, -6, 0, 13)
                    label.BackgroundTransparency = 1
                    label.Text = "[code] -> " .. code
                    label.TextColor3 = Color3.fromRGB(0, 200, 80)
