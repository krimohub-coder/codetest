-- 11. SLURP HUB SUBMIT LOGIK
local function clickButton(btn)
    if not btn then return false end
    
    pcall(function() btn.MouseButton1Click:Fire() end)
    pcall(function() btn.Activated:Fire() end)
    
    if typeof(firesignal) == "function" then
        pcall(firesignal, btn.MouseButton1Click)
        pcall(firesignal, btn.Activated)
    end
    
    if typeof(getconnections) == "function" then
        local ok, cs = pcall(getconnections, btn.MouseButton1Click)
        if ok and type(cs) == "table" then
            for _, c in ipairs(cs) do pcall(function() c:Fire() end) end
        end
        local ok2, cs2 = pcall(getconnections, btn.Activated)
        if ok2 and type(cs2) == "table" then
            for _, c in ipairs(cs2) do pcall(function() c:Fire() end) end
        end
    end
    
    if typeof(fireclick) == "function" then
        pcall(fireclick, btn)
    end
    
    return true
end

local function fireBoxFocusLost(box)
    if not box then return false end
    
    if typeof(firesignal) == "function" then
        pcall(firesignal, box.FocusLost, true)
    end
    
    if typeof(getconnections) == "function" then
        local ok, cs = pcall(getconnections, box.FocusLost)
        if ok and type(cs) == "table" then
            for _, c in ipairs(cs) do
                pcall(function() if c.Enabled ~= false then c:Fire(true) end end)
            end
        end
    end
    
    return true
end

local function typeAndSubmitCode(code)
    local pg = PlayerGui or LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end

    local codesGui = pg:FindFirstChild("Codes")
    if codesGui then
        if codesGui:IsA("ScreenGui") then codesGui.Enabled = true end
        local codesFrame = codesGui:FindFirstChild("Codes") or codesGui
        if codesFrame then
            if codesFrame:IsA("GuiObject") then codesFrame.Visible = true end
            local cur = codesFrame
            while cur and cur ~= codesGui do
                if cur:IsA("GuiObject") then cur.Visible = true end
                cur = cur.Parent
            end

            local box = nil
            for _, d in ipairs(codesFrame:GetDescendants()) do
                if d:IsA("TextBox") then
                    box = d
                    break
                end
            end

            local submitBtn = nil
            for _, d in ipairs(codesFrame:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) then
                    local n = d.Name:lower()
                    local txt = ""
                    pcall(function() txt = d.Text:lower() end)
                    if n:find("submit") or txt:find("submit") or n:find("redeem") or txt:find("redeem") or n:find("claim") or txt:find("confirm") or n:find("enter") then
                        submitBtn = d
                        break
                    end
                end
            end

            if box then
                box.Text = code
                if submitBtn then clickButton(submitBtn) end
                fireBoxFocusLost(box)
                return true
            end
        end
    end

    local box = nil
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextBox") and not box then
            box = d
            break
        end
    end

    if box then
        box.Text = code
        fireBoxFocusLost(box)
        
        local p = box.Parent
        for _ = 1, 6 do
            if not p then break end
            for _, d in ipairs(p:GetDescendants()) do
                if d:IsA("TextButton") or d:IsA("ImageButton") then
                    local n = d.Name:lower()
                    local txt = ""
                    pcall(function() txt = d.Text:lower() end)
                    if n:find("submit") or txt:find("submit") or n:find("redeem") or txt:find("redeem") or n:find("confirm") or txt:find("confirm") then
                        clickButton(d)
                        return true
                    end
                end
            end
            p = p.Parent
        end
        return true
    end
    
    return false
end

-- 12. APPEND TO BOX
local function appendToBox(text, isRiddleAnswer)
    if not text or text == "" or not _G.ScriptEnabled then return end
    if not _G.AutoWriteEnabled then return end
    
    -- Riddle Antworten
    if isRiddleAnswer then
        if CodeTextBox then
            if CodeTextBox.Text == "" or CodeTextBox.Text == "Code Here..." then
                CodeTextBox.Text = text
            else
                CodeTextBox.Text = CodeTextBox.Text .. text
            end
            table.insert(collectedCodes, text)
            refreshMainGUI()
        end
        return
    end
    
    -- Code sammeln
    _capturedParts[#_capturedParts + 1] = text
    local combinedCode = table.concat(_capturedParts)
    local capturedCount = #_capturedParts

    -- In die Box schreiben
    if CodeTextBox then
        if CodeTextBox.Text == "" or CodeTextBox.Text == "Code Here..." then
            CodeTextBox.Text = text
        else
            CodeTextBox.Text = CodeTextBox.Text .. text
        end
    end
    
    -- Counter aktualisieren
    table.insert(collectedCodes, text)
    refreshMainGUI()

    -- Submit wenn genug Wörter
    if capturedCount >= _G.SubmitAfterCount and _G.AutoSubmitEnabled then
        -- ZUERST Parts zurücksetzen (verhindert doppelten Submit)
        _capturedParts = {}
        
        local success = typeAndSubmitCode(combinedCode)
        
        -- Codes zurücksetzen
        table.clear(collectedCodes)
        refreshMainGUI()
        if CodeTextBox then 
            CodeTextBox.Text = ""
        end
        
        -- Automatisch auf STOP
        _G.ScriptEnabled = false
        if ToggleButton then
            ToggleButton.TextColor3 = Color3.fromRGB(0, 255, 100)
            ToggleButton.Text = "START"
        end
        
        if success then
            print("[KrimoHub] ✅ Codes erfolgreich eingelöst! Hub gestoppt.")
        else
            print("[KrimoHub] ⚠️ Submit fehlgeschlagen! Hub trotzdem gestoppt.")
        end
    end
end

-- 13. HISTORY SPEICHERN
local function saveToHistory(Word, fromSammy)
    if not _G.HistoryEnabled then return end
    if not fromSammy then return end
    if not Word or Word == "" then return end
    if Word:find(" ") then return end
    
    local time = os.date("%H:%M:%S")
    table.insert(history, { word = Word, time = time, fromSammy = true })
    
    if #history > 100 then
        for i = 1, #history - 100 do
            table.remove(history, 1)
        end
    end
    
    if historyOpen and HistoryGui then
        updateHistoryContent()
    end
end

-- 14. WATCHER
local function watchLabel(Label)
    pcall(function()
        if not Label:IsA("TextLabel") then return end
        local text = Label.Text
        if text == "" then return end
        
        if _G.RiddleSolverEnabled then
            local answer = answerQuestion(text)
            if answer then
                appendToBox(answer, true)
                return
            end
        end
        
        if text:find("%s") then return end
        
        saveToHistory(text, true)
        appendToBox(text, false)
    end)
end

