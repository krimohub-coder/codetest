local function createButton(parent, text, posX, width)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.fromOffset(width, 28)
    btn.Position = UDim2.fromOffset(posX, 74)
    btn.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextSize = 10
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.AutoButtonColor = false
    btn.ZIndex = 2

    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 7)

    local glow = Instance.new("ImageLabel", btn)
    glow.Size = UDim2.new(1, 20, 0, 16)
    glow.Position = UDim2.new(0, -10, 1, -6)
    glow.Image = "rbxassetid://5028857084"
    glow.ImageColor3 = Color3.fromRGB(180, 0, 255)
    glow.ImageTransparency = 0.6
    glow.BackgroundTransparency = 1
    glow.ZIndex = 0

    local origPos = btn.Position
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(200, 40, 255)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(180, 0, 255)}):Play()
    end)
    btn.MouseButton1Down:Connect(function()
        btn.Position = UDim2.fromOffset(posX + 2, 75)
    end)
    btn.MouseButton1Up:Connect(function()
        btn.Position = origPos
    end)

    return btn
end

