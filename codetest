-- 9. REFRESH MAIN GUI
local function refreshMainGUI()
    if not MainFrame then return end
    pcall(function()
        updateTitleCounter()
        
        local ContentFrame = MainFrame:FindFirstChild("ContentFrame")
        if not ContentFrame then return end
        
        local collectedLabel = ContentFrame:FindFirstChild("CollectedLabel")
        if collectedLabel then
            collectedLabel.Text = "🌸 Pasted: " .. #collectedCodes .. "/" .. _G.SubmitAfterCount
        end
        
        local listFrame = ContentFrame:FindFirstChild("CodeListFrame")
        if not listFrame then return end
        local scroll = listFrame:FindFirstChild("Scrolling")
        if not scroll then return end
        
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextLabel") and child.Name ~= "Placeholder" then
                child:Destroy()
            end
        end
        
        local placeholder = scroll:FindFirstChild("Placeholder")
        if placeholder then
            placeholder.Visible = (#collectedCodes == 0)
        end
        
        if #collectedCodes > 0 then
            local progressLabel = Instance.new("TextLabel")
            progressLabel.Name = "ProgressLabel"
            progressLabel.Size = UDim2.new(1, -6, 0, 16)
            progressLabel.BackgroundTransparency = 1
            progressLabel.Text = "🌸 Pasted " .. #collectedCodes .. "/" .. _G.SubmitAfterCount
            progressLabel.TextColor3 = Color3.fromRGB(200, 230, 255)
            progressLabel.Font = Enum.Font.GothamBold
            progressLabel.TextSize = 9
            progressLabel.TextXAlignment = Enum.TextXAlignment.Left
            progressLabel.TextYAlignment = Enum.TextYAlignment.Top
            progressLabel.Parent = scroll
            
            for i, code in ipairs(collectedCodes) do
                if code and code ~= "" then
                    local label = Instance.new("TextLabel")
                    label.Name = "CodeEntry"
                    label.Size = UDim2.new(1, -6, 0, 13)
                    label.BackgroundTransparency = 1
                    label.Text = "[code] -> " .. code
                    label.TextColor3 = Color3.fromRGB(0, 200, 80)
                    label.Font = Enum.Font.Gotham
                    label.TextSize = 9
                    label.TextXAlignment = Enum.TextXAlignment.Left
                    label.TextYAlignment = Enum.TextYAlignment.Top
                    label.Parent = scroll
                end
            end
        end
        
        local layout = scroll:FindFirstChildOfClass("UIListLayout")
        if layout then
            scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 6)
        end
    end)
end

