-- 17. APPEND TO BOX
local function appendToBox(text, isRiddleAnswer)
    if not text or text == "" or not _G.ScriptEnabled then return end
    if not _G.AutoWriteEnabled then return end
    if isProcessingSubmit then return end
    
    if isRiddleAnswer then
        if CodeTextBox then
            if CodeTextBox.Text == "" or CodeTextBox.Text == "Code Here..." then
                CodeTextBox.Text = text
            else
                CodeTextBox.Text = CodeTextBox.Text .. text
            end
            table.insert(collectedCodes, text)
            refreshMainGUI()
        end
        return
    end
    
    _capturedParts[#_capturedParts + 1] = text
    local combinedCode = table.concat(_capturedParts)
    local capturedCount = #_capturedParts

    if CodeTextBox then
        if CodeTextBox.Text == "" or CodeTextBox.Text == "Code Here..." then
            CodeTextBox.Text = text
        else
            CodeTextBox.Text = CodeTextBox.Text .. text
        end
    end
    
    table.insert(collectedCodes, text)
    refreshMainGUI()

    if capturedCount >= _submitAfter and _G.AutoSubmitEnabled and not isProcessingSubmit then
        isProcessingSubmit = true
        _capturedParts = {}
        
        local success = typeAndSubmitCode(combinedCode)
        
        table.clear(collectedCodes)
        refreshMainGUI()
        if CodeTextBox then CodeTextBox.Text = "" end
        
        _G.ScriptEnabled = false
        if ToggleButton then
            ToggleButton.TextColor3 = Color3.fromRGB(0, 255, 100)
            ToggleButton.Text = "START"
        end
        
        isProcessingSubmit = false
    end
end

-- 18. SAVE TO HISTORY
local function saveToHistory(Word, fromSammy)
    if not _G.HistoryEnabled or not fromSammy or not Word or Word == "" or Word:find(" ") then return end
    local time = os.date("%H:%M:%S")
    table.insert(history, { word = Word, time = time, fromSammy = true })
    if #history > 100 then table.remove(history, 1) end
    if historyOpen and HistoryGui then updateHistoryContent() end
end

-- 19. WATCHER
local function watchLabel(Label)
    pcall(function()
        if not Label:IsA("TextLabel") then return end
        local text = Label.Text
        if text == "" or isProcessingSubmit then return end
        
        if _G.RiddleSolverEnabled then
            local answer = answerQuestion(text)
            if answer then appendToBox(answer, true) return end
        end
        
        if text:find("%s") or _seen[text] then return end
        _seen[text] = true
        
        saveToHistory(text, true)
        appendToBox(text, false)
    end)
end

local function startAnnouncementWatcher()
    pcall(function()
        setupPaths()
        if not Announcements then return end
        for _, v in ipairs(Announcements:GetDescendants()) do watchLabel(v) end
        Announcements.DescendantAdded:Connect(watchLabel)
    end)
end

