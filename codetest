            if setclipboard then setclipboard(link) elseif toclipboard then toclipboard(link) end
            footerBtn.Text = "Link Copied!"
            task.wait(1.5)
            footerBtn.Text = "discord.gg/7Ea7qEsPzP"
        end)
        
        -- Window Minimize Toggle logic
        toggleMinBtn.MouseButton1Click:Connect(function()
            isMinimized = not isMinimized
            ContentFrame.Visible = not isMinimized
            MainFrame.Size = isMinimized and UDim2.new(0, PANEL_W, 0, 30) or UDim2.new(0, PANEL_W, 0, PANEL_H)
            toggleMinBtn.Text = isMinimized and "+" or "−"
        end)
        
        -- Drag Logic
        local dragging, dragStart, startPos
        MainFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = input.Position
                startPos = MainFrame.Position
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - dragStart
                MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        
        refreshMainGUI()
    end)
