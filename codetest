local scanning = false

local function isValidCode(msg)
    return msg:match("^[A-Za-z0-9]+$") ~= nil
end

local function updatePreview()
    setupPaths()
    if #buffer == 0 then
        if CodeTextBox then CodeTextBox.Text = "" end
        return
    end
    local count = math.min(#buffer, mode)
    local combined = table.concat(buffer, "", 1, count)
    if CodeTextBox then
        CodeTextBox.Text = combined
    end
end

local function processBuffer()
    if not scanning then return end
    
    while #buffer >= mode do
        local combined = table.concat(buffer, "", 1, mode)
        
        buffer = {}
        updatePreview()
        refreshMainGUI()
        
        local success, msg = levithonTypeAndSubmit(combined)
        if success then
            print("[KrimoHub] ✅ Levithon Auto-Redeemed: " .. combined)
        else
            print("[KrimoHub] ⚠️ Levithon Submit fehlgeschlagen: " .. tostring(msg))
        end
        
        task.wait(delay)
        hardReset()
    end
    updatePreview()
    refreshMainGUI()
end

onAnnouncement = function(txt)
    if not scanning or not txt or txt == "" then return end
    local msg = txt:match("^%s*(.-)%s*$")
    if msg and #msg > 0 and isValidCode(msg) then
        table.insert(buffer, msg)
        updatePreview()
        refreshMainGUI()
        print("[KrimoHub] Captured: " .. msg .. " (buffer: " .. #buffer .. "/" .. mode .. ")")
        
        if #buffer >= mode then
            task.spawn(processBuffer)
        end
    end
end

local function toggleScan()
    scanning = not scanning
    if scanning then
        _G.ScriptEnabled = true
        print("[KrimoHub] Scanning started.")
        hardReset()
        if scanBtn then
            scanBtn.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
            scanBtn.Text = "ON"
        end
    else
        _G.ScriptEnabled = false
        hardReset()
        print("[KrimoHub] Scanning stopped.")
        if scanBtn then
            scanBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            scanBtn.Text = "OFF"
        end
    end
end

local function watchLabel(Label)
    pcall(function()
        if not Label:IsA("TextLabel") then return end
        local text = Label.Text
        if text == "" then return end
        if isProcessingSubmit then return end
        
        if _G.RiddleSolverEnabled then
            local answer = answerQuestion(text)
            if answer then
                onAnnouncement(answer)
                return
            end
        end
        
        if text:find("%s") then return end
        
        if _seen[text] then return end
        _seen[text] = true
        task.delay(2, function() _seen[text] = nil end)
        
        if _G.HistoryEnabled then
            local time = os.date("%H:%M:%S")
            table.insert(history, { word = text, time = time, fromSammy = true })
            if #history > 100 then
                for i = 1, #history - 100 do table.remove(history, 1) end
            end
            if historyOpen and HistoryGui then
                updateHistoryContent()
            end
        end
        
        onAnnouncement(text)
    end)
end

local function startAnnouncementWatcher()
    pcall(function()
        setupPaths()
        if not Announcements then return end
        for _, v in ipairs(Announcements:GetDescendants()) do
            watchLabel(v)
        end
        Announcements.DescendantAdded:Connect(watchLabel)
    end)
end

local function verifySourceIsSammy(TO)
    pcall(function()
        if TO:IsDescendantOf(MainFrame) then return false end
        if TO:IsDescendantOf(HistoryGui) then return false end
        if TO:IsDescendantOf(HelpGui) then return false end
        if TO:IsDescendantOf(SettingsGui) then return false end
        local text = TO.Text or ""
        if text:lower():find("spydersammy") then return true end
        
        local parent = TO.Parent
        while parent do
            if parent:IsA("TextLabel") and parent.Text and parent.Text:lower():find("spydersammy") then
                return true
            end
            parent = parent.Parent
        end
    end)
    return false
end

local function handleIncomingText(TO)
    pcall(function()
        local text = TO.Text
        if text == "" then return end
        if verifySourceIsSammy(TO) then
            task.spawn(function() watchLabel(TO) end)
        end
    end)
end

local function hookUiTextObject(O)
    pcall(function()
        if O:IsA("TextLabel") then
            handleIncomingText(O)
            O:GetPropertyChangedSignal("Text"):Connect(function()
                handleIncomingText(O)
            end)
        end
    end)
end

