-- ============ ANNOUNCEMENT WATCHER ============
onAnnouncement = function(txt)
    if not scanning or not txt or txt == "" then return end
    local msg = txt:match("^%s*(.-)%s*$")
    if msg and #msg > 0 then
        if _splitBufferEnabled then
            -- JEDES WORT -> Kompletten Buffer submitten (wie KrimoHub!)
            for word in msg:gmatch("%w+") do
                if word:match("^[A-Za-z0-9]+$") then
                    processSplitSnippet(word, levithonTypeAndSubmit)
                end
            end
        else
            if msg:match("^[A-Za-z0-9]+$") then
                table.insert(buffer, msg)
                updatePreview()
                updateTitleCounter()
                if #buffer >= mode then
                    task.spawn(processBuffer)
                end
            end
        end
    end
end

local function watchLabel(Label)
    pcall(function()
        if not Label:IsA("TextLabel") then return end
        local text = Label.Text
        if text == "" then return end
        
        if _G.RiddleSolverEnabled then
            local answer = answerQuestion(text)
            if answer then
                if _G.HistoryEnabled then
                    table.insert(history, 1, {
                        word = answer,
                        time = os.date("%H:%M:%S"),
                        fromSammy = true
                    })
                    updateHistoryContent()
                end
                if scanning then
                    onAnnouncement(answer)
                end
                return
            end
        end
        
        if text:find("%s") and not _splitBufferEnabled then return end
        if _seen[text] then return end
        _seen[text] = true
        task.delay(2, function() _seen[text] = nil end)
        
        if _G.HistoryEnabled then
            local time = os.date("%H:%M:%S")
            table.insert(history, 1, {
                word = text,
                time = time,
                fromSammy = true
            })
            if #history > 100 then
                for i = 1, #history - 100 do table.remove(history, 1) end
            end
            if HistoryGui then
                updateHistoryContent()
            end
        end
        
        if scanning then
            onAnnouncement(text)
        end
    end)
end

local function startAnnouncementWatcher()
    pcall(function()
        setupPaths()
        if Announcements then
            for _, child in ipairs(Announcements:GetDescendants()) do
                if child:IsA("TextLabel") then
                    watchLabel(child)
                    child:GetPropertyChangedSignal("Text"):Connect(function()
                        watchLabel(child)
                    end)
                end
            end
            Announcements.DescendantAdded:Connect(function(child)
                if child:IsA("TextLabel") then
                    watchLabel(child)
                    child:GetPropertyChangedSignal("Text"):Connect(function()
                        watchLabel(child)
                    end)
                end
            end)
        end
    end)
end

task.spawn(startAnnouncementWatcher)

