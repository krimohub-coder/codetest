    creditLabel.BackgroundTransparency = 1
    creditLabel.Text = "🌸 Credits to momo.1711"
    creditLabel.TextColor3 = Color3.fromRGB(130, 170, 210)
    creditLabel.Font = Enum.Font.Gotham
    creditLabel.TextSize = 8
    creditLabel.TextXAlignment = Enum.TextXAlignment.Center
    creditLabel.ZIndex = 10
    creditLabel.Parent = ContentFrame
    
    -- Discord
    local footer = Instance.new("TextLabel")
    footer.Size = UDim2.new(1, -24, 0, 18)
    footer.Position = UDim2.new(0, 12, 0, 254)
    footer.BackgroundTransparency = 1
    footer.RichText = true
    footer.Text = '<font color="#88aaff">🌸 discord.gg/</font><font color="#66ccff"><b>7Ea7qEsPzP</b></font>'
    footer.TextColor3 = Color3.fromRGB(180, 200, 255)
    footer.TextSize = 10
    footer.Font = Enum.Font.GothamBold
    footer.TextXAlignment = Enum.TextXAlignment.Center
    footer.ZIndex = 10
    footer.Parent = ContentFrame
    
    local footerBtn = Instance.new("TextButton")
    footerBtn.Size = UDim2.new(1, -24, 0, 18)
    footerBtn.Position = UDim2.new(0, 12, 0, 254)
    footerBtn.BackgroundTransparency = 1
    footerBtn.Text = ""
    footerBtn.AutoButtonColor = false
    footerBtn.ZIndex = 10
    footerBtn.Parent = ContentFrame
    
    footerBtn.MouseButton1Click:Connect(function()
        local link = "https://discord.gg/7Ea7qEsPzP"
        if setclipboard then pcall(function() setclipboard(link) end)
        elseif toclipboard then pcall(function() toclipboard(link) end) end
    end)
    
    footerBtn.MouseEnter:Connect(function()
        footer.Text = '<font color="#88aaff">🌸 Click to copy: </font><font color="#66ccff"><b>discord.gg/7Ea7qEsPzP</b></font>'
    end)
    footerBtn.MouseLeave:Connect(function()
        footer.Text = '<font color="#88aaff">🌸 discord.gg/</font><font color="#66ccff"><b>7Ea7qEsPzP</b></font>'
    end)
    
    -- Minimieren
    local minimizedPos = UDim2.new(1, -PANEL_W - 8, 0, 8)
    
    local function applyMinimized(state)
        isMinimized = state
        if state then
            ContentFrame.Visible = false
            MainFrame.Size = UDim2.new(0, PANEL_W, 0, 26)
            MainFrame.Position = minimizedPos
            toggleMinBtn.Text = "+"
        else
            ContentFrame.Visible = true
            MainFrame.Size = UDim2.new(0, PANEL_W, 0, PANEL_H)
            MainFrame.Position = (config.panelX and config.panelY)
                and UDim2.new(0, config.panelX, 0, config.panelY)
                or UDim2.new(0.5, 0, 0.4, 0)
            toggleMinBtn.Text = "−"
        end
    end
    
    toggleMinBtn.MouseButton1Click:Connect(function()
        applyMinimized(not isMinimized)
    end)
    
    -- Drag
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    
    local function updateMain(input)
        if isMinimized then return end
        local delta = input.Position - dragStart
        local newX = startPos.X.Offset + delta.X
        local newY = startPos.Y.Offset + delta.Y
        config.panelX = newX
        config.panelY = newY
        saveConfig()
        MainFrame.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
    end
    
    MainFrame.InputBegan:Connect(function(input)
        if isMinimized then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    MainFrame.InputChanged:Connect(function(input)
        if isMinimized then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isMinimized then return end
        if input == dragInput and dragging then
            updateMain(input)
        end
    end)
    
    refreshMainGUI()
    print("[KrimoHub V4] GUI sichtbar!")
end

