local function answerQuestion(text)
    if not _G.RiddleSolverEnabled or not text or text == "" then return nil end
    local clean = text:lower():gsub("[%?%.%,!']", ""):gsub("^%s+", ""):gsub("%s+$", "")
    
    local removedWhat = clean:gsub("^what%s+", ""):gsub("^whats%s+", ""):gsub("^whatwas%s+", ""):gsub("^whatis%s+", "")
    if removedWhat ~= clean and SLURP_DB[removedWhat] then return SLURP_DB[removedWhat] end
    
    local removedWho = clean:gsub("^who%s+", ""):gsub("^whois%s+", ""):gsub("^whowas%s+", "")
    if removedWho ~= clean and SLURP_DB[removedWho] then return SLURP_DB[removedWho] end
    
    if SLURP_DB[clean] then return SLURP_DB[clean] end
    local noSpace = clean:gsub("%s+", "")
    if SLURP_DB[noSpace] then return SLURP_DB[noSpace] end
    local replaced = clean:gsub("fav", "favorite")
    if SLURP_DB[replaced] then return SLURP_DB[replaced] end
    
    local bestMatch = nil
    local maxMatchLength = 0
    for key, value in pairs(SLURP_DB) do
        if clean:find(key, 1, true) then
            if #key > maxMatchLength then
                maxMatchLength = #key
                bestMatch = value
            end
        end
    end
    return bestMatch
end

-- 8. TYPE AND SUBMIT CODE
local function clickButton(btn)
    if not btn then return false end
    pcall(function() btn.MouseButton1Click:Fire() end)
    pcall(function() btn.Activated:Fire() end)
    if typeof(firesignal) == "function" then
        pcall(firesignal, btn.MouseButton1Click)
        pcall(firesignal, btn.Activated)
    end
    if typeof(getconnections) == "function" then
        local ok, cs = pcall(getconnections, btn.MouseButton1Click)
        if ok and type(cs) == "table" then for _, c in ipairs(cs) do pcall(function() c:Fire() end) end end
        local ok2, cs2 = pcall(getconnections, btn.Activated)
        if ok2 and type(cs2) == "table" then for _, c in ipairs(cs2) do pcall(function() c:Fire() end) end end
    end
    if typeof(fireclick) == "function" then pcall(fireclick, btn) end
    return true
end

local function fireBoxFocusLost(box)
    if not box then return false end
    if typeof(firesignal) == "function" then pcall(firesignal, box.FocusLost, true) end
    if typeof(getconnections) == "function" then
        local ok, cs = pcall(getconnections, box.FocusLost)
        if ok and type(cs) == "table" then
            for _, c in ipairs(cs) do pcall(function() if c.Enabled ~= false then c:Fire(true) end end) end
        end
    end
    return true
end

local function typeAndSubmitCode(code)
    local pg = PlayerGui or LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end

    local codesGui = pg:FindFirstChild("Codes")
    if codesGui then
        if codesGui:IsA("ScreenGui") then codesGui.Enabled = true end
        local codesFrame = codesGui:FindFirstChild("Codes") or codesGui
        if codesFrame then
            if codesFrame:IsA("GuiObject") then codesFrame.Visible = true end
            local cur = codesFrame
            while cur and cur ~= codesGui do
                if cur:IsA("GuiObject") then cur.Visible = true end
                cur = cur.Parent
            end

            local box = nil
            for _, d in ipairs(codesFrame:GetDescendants()) do
                if d:IsA("TextBox") then box = d break end
            end

            local submitBtn = nil
            for _, d in ipairs(codesFrame:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) then
                    local n = d.Name:lower()
                    local txt = ""
                    pcall(function() txt = d.Text:lower() end)
                    if n:find("submit") or txt:find("submit") or n:find("redeem") or txt:find("redeem") or n:find("claim") or txt:find("confirm") or n:find("enter") or n:find("send") then
                        submitBtn = d
                        break
                    end
                end
            end

            if box then
                box.Text = code
                if submitBtn then clickButton(submitBtn) end
                fireBoxFocusLost(box)
                return true
            end
        end
    end

    local box = nil
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextBox") and not box then box = d break end
    end

    if box then
        box.Text = code
        fireBoxFocusLost(box)
        local p = box.Parent
        for _ = 1, 6 do
            if not p then break end
            for _, d in ipairs(p:GetDescendants()) do
                if d:IsA("TextButton") or d:IsA("ImageButton") then
                    local n = d.Name:lower()
                    local txt = ""
                    pcall(function() txt = d.Text:lower() end)
                    if n:find("submit") or txt:find("submit") or n:find("redeem") or txt:find("redeem") or n:find("confirm") or txt:find("confirm") or n:find("send") or txt:find("send") then
                        clickButton(d)
                        return true
                    end
                end
            end
            p = p.Parent
        end
        return true
    end
    return false
end

