local function verifySourceIsSammy(TO)
    pcall(function()
        if TO:IsDescendantOf(MainFrame) or TO:IsDescendantOf(HistoryGui) or TO:IsDescendantOf(HelpGui) or TO:IsDescendantOf(SettingsGui) then return false end
        local text = TO.Text or ""
        if text:lower():find("spydersammy") then return true end
        
        local parent = TO.Parent
        while parent do
            if parent:IsA("TextLabel") and parent.Text and parent.Text:lower():find("spydersammy") then return true end
            parent = parent.Parent
        end
    end)
    return false
end

local function handleIncomingText(TO)
    pcall(function()
        local text = TO.Text
        if text == "" then return end
        if verifySourceIsSammy(TO) then
