local function answerQuestion(text)
    if not _G.RiddleSolverEnabled or not text or text == "" then return nil end
    
    local clean = text:lower():gsub("[%?%.%,!']", ""):gsub("^%s+", ""):gsub("%s+$", "")
    
    local removedWhat = clean:gsub("^what%s+", ""):gsub("^whats%s+", ""):gsub("^whatwas%s+", ""):gsub("^whatis%s+", "")
    if removedWhat ~= clean and SAB_DB[removedWhat] then
        return SAB_DB[removedWhat]
    end
    
    local removedWho = clean:gsub("^who%s+", ""):gsub("^whois%s+", ""):gsub("^whowas%s+", "")
    if removedWho ~= clean and SAB_DB[removedWho] then
        return SAB_DB[removedWho]
    end
    
    if SAB_DB[clean] then 
        return SAB_DB[clean] 
    end
    
    local noSpace = clean:gsub("%s+", "")
    if SAB_DB[noSpace] then
        return SAB_DB[noSpace]
    end
    
    local replaced = clean:gsub("fav", "favorite")
    if SAB_DB[replaced] then
        return SAB_DB[replaced]
    end
    
    local bestMatch = nil
    local maxMatchLength = 0
    
    for key, value in pairs(SAB_DB) do
        if clean:find(key, 1, true) then
            if #key > maxMatchLength then
                maxMatchLength = #key
                bestMatch = value
            end
        end
    end
    
    if not bestMatch and removedWhat ~= clean then
        for key, value in pairs(SAB_DB) do
            if removedWhat:find(key, 1, true) then
                if #key > maxMatchLength then
                    maxMatchLength = #key
                    bestMatch = value
                end
            end
        end
    end
    
    return bestMatch
end

