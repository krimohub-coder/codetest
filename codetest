local hasFS = pcall(function() return type(writefile) == "function" end)
local config = { panelX = nil, panelY = nil }

local function loadConfig()
    if not hasFS then return end
    pcall(function()
        if isfile and isfile("KrimoHub_config.json") then
            local data = game:GetService("HttpService"):JSONDecode(readfile("KrimoHub_config.json"))
            if type(data) == "table" then
                for k, v in pairs(data) do config[k] = v end
            end
        end
    end)
end

local function saveConfig()
    if not hasFS then return end
    pcall(function() 
        if writefile then 
            writefile("KrimoHub_config.json", game:GetService("HttpService"):JSONEncode(config)) 
        end
    end)
end
