local function normalize(s)
    if type(s) ~= "string" then return "" end
    return s:upper():gsub("%s+", ""):gsub("[^%w]", "")
end

local function cleanQuery(s)
    if type(s) ~= "string" then return "" end
    s = s:lower()
    s = s:gsub("<[^>]->", "")
    s = s:gsub("[^%w%s]", " ")
    s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    return s
end

local function answerQuestion(text)
    if not _G.RiddleSolverEnabled or not text or text == "" then return nil end
    
    local raw = text:lower()
    raw = raw:gsub("<[^>]->", "")
    local q = cleanQuery(text)
    if q == "" then q = raw end

    if SAB_DB[q] then return normalize(SAB_DB[q]) end

    local stripped = q
        :gsub("^what is the ", ""):gsub("^what is a ", ""):gsub("^what is ", "")
        :gsub("^whats the ", ""):gsub("^whats a ", ""):gsub("^whats ", "")
        :gsub("^who is the ", ""):gsub("^who is ", ""):gsub("^whos ", "")
        :gsub("^how old ", ""):gsub("^how many ", "")
        :gsub("^where is the ", ""):gsub("^where is ", ""):gsub("^where was ", "")
        :gsub("^when was the ", ""):gsub("^when was ", "")
        :gsub("^what was the ", ""):gsub("^what was ", "")
        :gsub("^tell me the ", ""):gsub("^tell me ", "")
        :gsub("^my ", ""):gsub("^the ", ""):gsub("^a ", ""):gsub("^an ", "")

    if SAB_DB[stripped] then return normalize(SAB_DB[stripped]) end

    local bestKey, bestLen = nil, 0
    for key, ans in pairs(SAB_DB) do
        if #key >= 3 and #key > bestLen then
            if q:find(key, 1, true) or stripped:find(key, 1, true) or raw:find(key, 1, true) then
                bestKey = key
                bestLen = #key
            end
        end
    end
    if bestKey then return normalize(SAB_DB[bestKey]) end

    return nil
end

