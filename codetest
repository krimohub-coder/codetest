local function loadConfig()
    if not hasFS then return end
    pcall(function()
        if isfile and isfile("KrimoHub_config.json") then
            local data = HttpService:JSONDecode(readfile("KrimoHub_config.json"))
            if type(data) == "table" and data.guiColor then
                _G.GuiColor = data.guiColor
            end
        end
    end)
