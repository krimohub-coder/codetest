local function answerQuestion(text)
    if not _G.RiddleSolverEnabled or not text or text == "" then return nil end
    local clean = text:lower():gsub("[%?%.%,!']", ""):gsub("^%s+", ""):gsub("%s+$", "")
    return SLURP_DB[clean]
end

-- AUTO SUBMIT & TYPE LOGIC
local function isOwnGui(obj)
    local p = obj
    for i=1,10 do
        if not p then break end
        if p.Name == "KrimoHubGui" or p.Name == "KrimoSettingsTest" or p.Name == "KrimoHelpGui" then
            return true
        end
        p = p.Parent
    end
    return false
end

local function getCodeBoxes()
    local boxes = {}
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return boxes end
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOwnGui(g) then
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextBox") and not isOwnGui(d) and d.Visible then
                    table.insert(boxes, d)
                end
            end
        end
    end
    return boxes
end

local function findSubmitButtons()
    local btns = {}
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return btns end
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOwnGui(g) then
            for _, d in ipairs(g:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwnGui(d) and d.Visible then
                    local n = d.Name:lower()
                    local pn = (d.Parent and d.Parent.Name or ""):lower()
                    if n:find("code") or n:find("redeem") or n:find("submit") or pn:find("code") or pn:find("redeem") then
                        table.insert(btns, d)
                    end
                end
            end
        end
    end
    return btns
end

local function submitCode(code)
    local boxes = getCodeBoxes()
    if #boxes > 0 then
        local box = boxes[1]
        box.Text = code
        task.wait(0.05)
        
        local btns = findSubmitButtons()
        for _, b in ipairs(btns) do
            pcall(function() b.MouseButton1Click:Fire() end)
            pcall(function() b.Activated:Fire() end)
        end
        return true
    end
    return false
end

-- COUNTER & BUFFER SYSTEM
local _msgBuffer = {}
local _seen = {}
local isProcessingSubmit = false
local collectedCodes = {}
local refreshMainGUI

local function appendToBox(text)
    if not text or text == "" then return end
    if not _G.ScriptEnabled or not _G.AutoWriteEnabled or isProcessingSubmit then return end
    
    if _seen[text] then return end
    _seen[text] = true
    task.delay(2, function() _seen[text] = nil end)
    
    if _G.RiddleSolverEnabled then
        local ans = answerQuestion(text)
        if ans then
            submitCode(ans)
            return
        end
    end

    table.insert(_msgBuffer, text)
    table.insert(collectedCodes, text)
    
    local combinedCode = table.concat(_msgBuffer)
    local boxes = getCodeBoxes()
    if #boxes > 0 then
        boxes[1].Text = combinedCode
    end
    
    if refreshMainGUI then refreshMainGUI() end

    if #collectedCodes >= _G.SubmitAfterCount then
        isProcessingSubmit = true
        task.spawn(function()
            if _G.AutoSubmitEnabled then
                submitCode(combinedCode)
            end
            task.wait(0.5)
            _msgBuffer = {}
            collectedCodes = {}
            if refreshMainGUI then refreshMainGUI() end
            isProcessingSubmit = false
        end)
    end
end

-- ANNOUNCEMENT WATCHER
local function watchLabel(Label)
    if Label:IsA("TextLabel") and Label.Text ~= "" then
        appendToBox(Label.Text)
    end
end

local function startAnnouncementWatcher()
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    for _, child in ipairs(PlayerGui:GetDescendants()) do
        if child:IsA("TextLabel") then
            child:GetPropertyChangedSignal("Text"):Connect(function() watchLabel(child) end)
        end
    end
    PlayerGui.DescendantAdded:Connect(function(O)
        if O:IsA("TextLabel") then
            O:GetPropertyChangedSignal("Text"):Connect(function() watchLabel(O) end)
        end
    end)
end

-- GUI BUILDER
local MainFrame, ScreenGui, TitleCounterLabel
local PANEL_W, PANEL_H = 250, 270

local function hardReset()
    table.clear(collectedCodes)
    _msgBuffer = {}
    _seen = {}
    isProcessingSubmit = false
    if refreshMainGUI then refreshMainGUI() end
end

refreshMainGUI = function()
    if not MainFrame then return end
    pcall(function()
        if TitleCounterLabel then
            TitleCounterLabel.Text = "📊 " .. #collectedCodes .. "/" .. _G.SubmitAfterCount
        end
        
        local ContentFrame = MainFrame:FindFirstChild("ContentFrame")
        if not ContentFrame then return end
        
        local listFrame = ContentFrame:FindFirstChild("CodeListFrame")
        if not listFrame then return end
        local scroll = listFrame:FindFirstChild("Scrolling")
        if not scroll then return end
        
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextLabel") and child.Name ~= "Placeholder" then
                child:Destroy()
            end
        end
        
        local placeholder = scroll:FindFirstChild("Placeholder")
        if placeholder then
            placeholder.Visible = (#collectedCodes == 0)
        end
        
        for _, code in ipairs(collectedCodes) do
            local label = Instance.new("TextLabel")
            label.Name = "CodeEntry"
            label.Size = UDim2.new(1, -6, 0, 13)
            label.BackgroundTransparency = 1
            label.Text = "[code] -> " .. code
            label.TextColor3 = Color3.fromRGB(0, 255, 120)
            label.Font = Enum.Font.Gotham
            label.TextSize = 9
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = scroll
        end
    end)
end

