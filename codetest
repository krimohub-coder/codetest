    if scanBtn then
        if scanning then
            scanBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            scanBtn.Text = "🔍 Start Scanning: ON"
        else
            scanBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
            scanBtn.Text = "🔍 Start Scanning: OFF"
        end
    end
    hardReset()
    print("[GrimHub] Scanning → " .. (scanning and "ON" or "OFF"))
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode.Name == _G.keybindName then
            toggleScan()
        end
    end
end)

local function updateTitleCounter()
    if TitleCounterLabel then
        TitleCounterLabel.Text = #buffer .. "/" .. mode
    end
end

local function updatePreview()
    setupPaths()
    if #buffer == 0 then
        if CodeTextBox then CodeTextBox.Text = "" end
        return
    end
    local count = math.min(#buffer, mode)
    local combined = table.concat(buffer, "", 1, count)
    if CodeTextBox then
        CodeTextBox.Text = combined
    end
end

local function hardReset()
    buffer = {}
    _seen = {}
    isProcessingSubmit = false
    resetSplitBuffer()
    
    setupPaths()
    if CodeTextBox then 
        pcall(function() CodeTextBox.Text = "" end)
    end
    
    updatePreview()
    updateTitleCounter()
    if refreshMainGUI then pcall(refreshMainGUI) end
    print("[GrimHub] 🔄 Hard Reset - Buffer cleared (0/" .. tostring(mode) .. ")")
end

local function hookTextBoxClearing()
    setupPaths()
    if CodeTextBox then
        CodeTextBox:GetPropertyChangedSignal("Text"):Connect(function()
            if CodeTextBox.Text == "" and #buffer > 0 then
                hardReset()
            end
        end)
    end
end
task.spawn(hookTextBoxClearing)

local function processBuffer()
    if not scanning or isProcessingSubmit then return end
    
    while #buffer >= mode do
        isProcessingSubmit = true
        local combined = table.concat(buffer, "", 1, mode)
        
        buffer = {}
        updatePreview()
        updateTitleCounter()
        
        local success, msg = levithonTypeAndSubmit(combined)
        if success then
            print("[GrimHub] ✅ Auto-Redeemed: " .. combined)
        else
            print("[GrimHub] ⚠️ Submit failed: " .. tostring(msg))
        end
        
        task.wait(delay)
        hardReset()
        break
    end
    updatePreview()
    updateTitleCounter()
end

