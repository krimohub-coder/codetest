-- 4. AUTO BUY LOGIC
local promptConnections = {}
local isAutoBuying = false
local renderConnection = nil
local addedConnection = nil

local function isValidPrompt(prompt)
    if not (prompt and prompt:IsA("ProximityPrompt")) then return false end
    local attachment = prompt.Parent
    if not attachment or attachment.Name ~= "PromptAttachment" then return false end
    local part = attachment.Parent
    if not part or part.Name ~= "Part" then return false end
    local model = part.Parent
    return model and model:IsA("Model") and true or false
end

local function getPromptPosition(prompt)
    if prompt and prompt.Parent then
        if prompt.Parent:IsA("Attachment") and prompt.Parent.Name == "PromptAttachment" and (prompt.Parent.Parent and prompt.Parent.Parent.Name == "Part") then
            return prompt.Parent.Parent.Position
        elseif prompt.Parent:IsA("BasePart") then
            return prompt.Parent.Position
        elseif prompt.Parent:IsA("Model") and prompt.Parent.PrimaryPart then
            return prompt.Parent.PrimaryPart.Position
        end
    end
    return nil
end

local function isPromptVisibleOnScreen(prompt)
    local pos = getPromptPosition(prompt)
    if not pos then return false end
    local _, visible = Workspace.CurrentCamera:WorldToViewportPoint(pos)
    return visible
end

local function beginInput(prompt)
    local inputs = { Enum.UserInputType.Keyboard, Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch }
    for _, input in ipairs(inputs) do
        pcall(function() prompt:InputHoldBegin(input) end)
    end
end

local function endInput(prompt)
    local inputs = { Enum.UserInputType.Keyboard, Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch }
    for _, input in ipairs(inputs) do
        pcall(function() prompt:InputHoldEnd(input) end)
    end
end

local function registerPrompt(prompt)
    if isValidPrompt(prompt) and not promptConnections[prompt] then
        promptConnections[prompt] = true
    end
end

local function startAutoBuy()
    if not isAutoBuying then
        isAutoBuying = true
        for _, obj in ipairs(Workspace:GetDescendants()) do registerPrompt(obj) end
        if addedConnection then addedConnection:Disconnect() end
        addedConnection = Workspace.DescendantAdded:Connect(registerPrompt)
        
        if renderConnection then renderConnection:Disconnect() end
        renderConnection = RunService.RenderStepped:Connect(function()
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                for prompt, _ in pairs(promptConnections) do
                    if prompt and prompt.Parent and isValidPrompt(prompt) then
                        local pos = getPromptPosition(prompt)
                        if pos then
                            if (rootPart.Position - pos).Magnitude > 15 or not isPromptVisibleOnScreen(prompt) then
                                endInput(prompt)
                            else
                                beginInput(prompt)
                            end
                        else
                            promptConnections[prompt] = nil
                        end
                    else
                        promptConnections[prompt] = nil
                    end
                end
            end
        end)
    end
end

local function stopAutoBuy()
    if isAutoBuying then
        isAutoBuying = false
        if renderConnection then renderConnection:Disconnect() renderConnection = nil end
        if addedConnection then addedConnection:Disconnect() addedConnection = nil end
        for prompt, _ in pairs(promptConnections) do endInput(prompt) end
        promptConnections = {}
    end
end

