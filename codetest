local function isOwnGui(obj)
    local p = obj
    for i=1,10 do
        if not p then break end
        if p.Name == "KrimoHubGui" or p.Name == "KrimoSettingsTest" or p.Name == "KrimoHelpGui" then
            return true
        end
        p = p.Parent
    end
    return false
end

local function isGuiVisible(guiObj)
    if not guiObj then return false end
    local p = guiObj
    while p do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") then return p.Enabled end
        p = p.Parent
    end
    return true
end

local function getCodeBoxes(pg)
    local boxes = {}
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOwnGui(g) then
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextBox") and not isOwnGui(d) then
                    table.insert(boxes, d)
                end
            end
        end
    end
    return boxes
end

local function findSubmitButtons(pg)
    local btns = {}
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOwnGui(g) then
            for _, d in ipairs(g:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwnGui(d) then
                    local n = d.Name:lower()
                    local pn = (d.Parent and d.Parent.Name or ""):lower()
                    if (n:find("code") or n:find("redeem") or pn:find("code") or pn:find("redeem")) and isGuiVisible(d) then
                        table.insert(btns, d)
                    end
                end
            end
        end
    end
    return btns
end

local function clickButton(btn)
    if not btn then return false end
    
    local methods = {}
    table.insert(methods, function() btn.MouseButton1Click:Fire() end)
    table.insert(methods, function() btn.Activated:Fire() end)
    
    if typeof(firesignal) == "function" then
        table.insert(methods, function() firesignal(btn.MouseButton1Click) end)
        table.insert(methods, function() firesignal(btn.Activated) end)
    end
    
    if typeof(getconnections) == "function" then
        table.insert(methods, function()
            local ok, cs = pcall(getconnections, btn.MouseButton1Click)
            if ok and type(cs) == "table" then
                for _, c in ipairs(cs) do pcall(function() c:Fire() end) end
            end
            local ok2, cs2 = pcall(getconnections, btn.Activated)
            if ok2 and type(cs2) == "table" then
                for _, c in ipairs(cs2) do pcall(function() c:Fire() end) end
            end
        end)
    end
    
    if typeof(fireclick) == "function" then
        table.insert(methods, function() fireclick(btn) end)
    end
    
    local any = false
    for _, f in ipairs(methods) do
        local ok = pcall(f)
        any = any or ok
    end
    return any
end

local function fireFocusLost(box)
    if not box then return false end
    
    local any = false
    
    if typeof(firesignal) == "function" then
        local ok = pcall(firesignal, box.FocusLost, true)
        any = any or ok
    end
    
    if typeof(getconnections) == "function" then
        local ok, cs = pcall(getconnections, box.FocusLost)
        if ok and type(cs) == "table" then
            for _, c in ipairs(cs) do
                local f
                pcall(function() f = c.Function end)
                if f and typeof(getupvalues) == "function" and typeof(setupvalue) == "function" then
                    local uok, ups = pcall(getupvalues, f)
                    if uok and type(ups) == "table" then
                        for i, v in pairs(ups) do
                            if type(v) == "boolean" and v == true then
                                pcall(setupvalue, f, i, false)
                            end
                        end
                    end
                end
                local fok = pcall(function() if c.Enabled ~= false then c:Fire(true) end end)
                any = any or fok
            end
        end
    end
    
    return any
end

-- Haupt-Submit-Funktion
local function submitCode(code)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false, "no PlayerGui" end
    
    -- 1. Spezifischer Codes-GUI-Pfad
    local codesGui = pg:FindFirstChild("Codes")
    if codesGui then
        if codesGui:IsA("ScreenGui") then codesGui.Enabled = true end
        local codesFrame = codesGui:FindFirstChild("Codes") or codesGui
        if codesFrame then
            if codesFrame:IsA("GuiObject") then codesFrame.Visible = true end
            local cur = codesFrame
            while cur and cur ~= codesGui do
                if cur:IsA("GuiObject") then cur.Visible = true end
                cur = cur.Parent
            end
            
            local box = nil
            for _, d in ipairs(codesFrame:GetDescendants()) do
                if d:IsA("TextBox") and not isOwnGui(d) then
                    box = d
                    break
                end
            end
            
            local btn = nil
            for _, d in ipairs(codesFrame:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwnGui(d) then
                    local n = d.Name:lower()
                    local t = ""
                    pcall(function() t = d.Text:lower() end)
                    if n:find("submit") or t:find("submit") or n:find("redeem") or t:find("redeem") or n:find("claim") or t:find("confirm") or n:find("enter") then
                        btn = d
                        break
                    end
                end
            end
            
            if not btn then
                for _, d in ipairs(codesFrame:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwnGui(d) then
                        local n = d.Name:lower()
                        if not n:find("close") and not n:find("x") and not n:find("toggle") then
                            btn = d
                            break
                        end
                    end
                end
            end
            
            if box then
                pcall(function() box.Text = code end)
                task.wait(0.05)
                if btn then clickButton(btn) end
                fireFocusLost(box)
                return true, "submitted via PlayerGui.Codes"
            end
        end
    end
    
    -- 2. Dynamische Suche
    local btns = findSubmitButtons(pg)
    for _, b in ipairs(btns) do
        clickButton(b)
        task.wait(0.05)
    end
    task.wait(0.2)
    
    local box = nil
    local deadline = math.floor(os.clock() + 2)
    while os.clock() < deadline do
        local all = getCodeBoxes(pg)
        for _, d in ipairs(all) do
            if isGuiVisible(d) then
                local n = d.Name:lower()
                local pn = (d.Parent and d.Parent.Name or ""):lower()
                if n:find("code") or pn:find("code") or n:find("redeem") or pn:find("redeem") or n:find("input") or pn:find("textbox") or n:find("enter") then
                    box = d
                    break
                end
            end
        end
        if not box then
            for _, d in ipairs(all) do
                if isGuiVisible(d) then
                    box = d
                    break
                end
            end
        end
        if box then break end
        task.wait(0.1)
    end
    
    if not box then return false, "no codebox visible" end
    
    pcall(function() box.Text = code end)
    task.wait(0.05)
    
    local btn = nil
    local names = {"submit", "redeem", "claim", "confirm", "enter", "send", "apply", "ok", "use", "go", "check"}
    local p = box.Parent
    for i = 1, 8 do
        if not p then break end
        for _, d in ipairs(p:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwnGui(d) and d ~= box then
                local n = d.Name:lower()
                local t = ""
                pcall(function() t = d.Text:lower() end)
                for _, sn in ipairs(names) do
                    if n:find(sn) or t:find(sn) then
                        if isGuiVisible(d) then
                            btn = d
                            break
                        end
                    end
                end
                if btn then break end
            end
        end
        if btn then break end
        p = p.Parent
    end
    
    if btn then clickButton(btn) end
    fireFocusLost(box)
    return true, "submitted via dynamic search"
end

local function findCodeBox()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    
    -- 1. Spezifischer Pfad
    local codesGui = pg:FindFirstChild("Codes")
    if codesGui and codesGui:IsA("ScreenGui") then
        local codesFrame = codesGui:FindFirstChild("Codes")
        if codesFrame then
            local codeRedeem = codesFrame:FindFirstChild("CodeRedeem")
            if codeRedeem then
                local box = codeRedeem:FindFirstChild("TextBox")
                if box and box:IsA("TextBox") and isGuiVisible(box) then
                    return box
                end
            end
        end
    end
    
    -- 2. Dynamische Suche
    local all = getCodeBoxes(pg)
    for _, b in ipairs(all) do
        if isGuiVisible(b) then
            local n = b.Name:lower()
            local pn = (b.Parent and b.Parent.Name or ""):lower()
            if n:find("code") or pn:find("code") or n:find("redeem") or pn:find("redeem") or n:find("input") then
                return b
            end
        end
    end
    
    for _, b in ipairs(all) do
        if isGuiVisible(b) then
            return b
        end
    end
    
    return nil
end

