local _msgBuffer = {}
local _seen = {}
local _submitAfter = _G.SubmitAfterCount
local isProcessingSubmit = false
local collectedCodes = {}
local history = {}

-- APPEND TO BOX (MIT COUNTER FIX)
local function appendToBox(text)
    if not text or text == "" then return end
    if not _G.ScriptEnabled then return end
    if not _G.AutoWriteEnabled then return end
    if isProcessingSubmit then return end
    
    -- Riddle Solver
    if _G.RiddleSolverEnabled then
        local answer = answerQuestion(text)
        if answer then
            local box = findCodeBox()
            if box then
                pcall(function() box.Text = answer end)
                if _G.AutoSubmitEnabled then
                    task.spawn(function()
                        if _delay > 0 then task.wait(_delay) end
                        submitCode(answer)
                    end)
                end
            end
            return
        end
    end
    
    -- Nur Wörter ohne Leerzeichen (Codes)
    if text:find("%s") then return end
    
    if _seen[text] then return end
    _seen[text] = true
    task.delay(2, function() _seen[text] = nil end)
    
    _msgBuffer[#_msgBuffer + 1] = text
    local combinedCode = table.concat(_msgBuffer)
    local capturedCount = #_msgBuffer
    
    -- In CodeBox schreiben
    local box = findCodeBox()
    if box then
        pcall(function() box.Text = combinedCode end)
        print("[KrimoHub] 📝 Code geschrieben: " .. combinedCode)
    end
    
    -- 🔥 COUNTER AKTUALISIEREN 🔥
    table.insert(collectedCodes, text)
    refreshMainGUI()
    
    if capturedCount >= _submitAfter and _G.AutoSubmitEnabled and not isProcessingSubmit then
        isProcessingSubmit = true
        _msgBuffer = {}
        
        if _delay > 0 then
            task.wait(_delay)
        end
        
        local success, msg = submitCode(combinedCode)
        
        table.clear(collectedCodes)
        refreshMainGUI()
        
        _G.ScriptEnabled = false
        if ToggleButton then
            ToggleButton.TextColor3 = Color3.fromRGB(0, 255, 100)
            ToggleButton.Text = "START"
        end
        
        isProcessingSubmit = false
        
        if success then
            print("[KrimoHub] ✅ Codes erfolgreich eingelöst! Hub gestoppt.")
        else
            print("[KrimoHub] ⚠️ Submit fehlgeschlagen: " .. tostring(msg))
        end
    end
end

