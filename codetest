-- 9. RETYPE INVALID LOGIK (FIXED - SPEICHERT KOMPLETTEN CODE)
local function isBoxVisible(box)
    if not box or not box.Parent then return false end
    local current = box
    while current do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("ScreenGui") and not current.Enabled then return false end
        current = current.Parent
    end
    return true
end

local function getAceCodeBox()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextBox") and d:IsDescendantOf(pg:FindFirstChild("Codes")) then
            return d
        end
    end
    return CodeTextBox
end

local function clearPendingSubmission()
    pendingRejectedToken = pendingRejectedToken + 1
    pendingRejectedText = nil
    pendingRejectedBox = nil
    pendingRejectedUntil = 0
end

-- FIX: Speichert den KOMPLETTEN Code-String, nicht nur das letzte Wort
local function rememberPendingSubmission(box, fullCodeText)
    if not _G.RetypeInvalidEnabled then return end
    if not fullCodeText or fullCodeText == "" then return end
    pendingRejectedToken = pendingRejectedToken + 1
    local token = pendingRejectedToken
    pendingRejectedText = fullCodeText  -- SPEICHERT DEN GESAMTEN CODE
    pendingRejectedBox = box
    pendingRejectedUntil = os.clock() + 8
    task.delay(8, function()
        if token == pendingRejectedToken then
            clearPendingSubmission()
        end
    end)
end

-- FIX: Stellt den KOMPLETTEN Code wieder her
local function restoreRejectedText(box, previousText)
    if not _G.RetypeInvalidEnabled then return false end
    if not previousText or previousText == "" then return false end
    RunService.Heartbeat:Wait()
    local repasteBox = getAceCodeBox() or box
    if not repasteBox or not isBoxVisible(repasteBox) then return false end
    local restored = pcall(function()
        repasteBox.Text = previousText  -- STELLT DEN GESAMTEN CODE WIEDER HER
    end)
    return restored
end

local function handleRedemptionFeedback(text)
    if not _G.RetypeInvalidEnabled then return end
    if not pendingRejectedText then return end
    if os.clock() > pendingRejectedUntil then
        clearPendingSubmission()
        return
    end
    local lower = tostring(text or ""):lower()
    local rejected = lower:find("invalid", 1, true)
        or lower:find("expired", 1, true)
        or lower:find("already redeemed", 1, true)
        or lower:find("already used", 1, true)
        or lower:find("doesn't exist", 1, true)
        or lower:find("does not exist", 1, true)
        or lower:find("not found", 1, true)
        or lower:find("rejected", 1, true)
    if not rejected then return end
    local previousText = pendingRejectedText
    local previousBox = pendingRejectedBox
    local restored = restoreRejectedText(previousBox, previousText)
    clearPendingSubmission()
end

-- 10. SUBMIT (MERKT SICH DEN KOMPLETTEN CODE FÜR RETYPE)
local function fireSignal(sig)
    if not sig then return end
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(sig)) do
                if c.Fire then c:Fire() end
            end
        end
    end)
    if firesignal then
        pcall(function() firesignal(sig) end)
    end
end

local function triggerSubmit()
    if submitCooldown then return false end
    submitCooldown = true
    task.delay(0.15, function() submitCooldown = false end)
    
    setupPaths()
    
    -- MERK DIR DEN KOMPLETTEN CODE für Retype Invalid
    local fullCode = table.concat(collectedCodes)
    if fullCode ~= "" then
        lastSubmittedCode = fullCode
        rememberPendingSubmission(CodeTextBox, fullCode)
    end
    
    if ConfirmButton and ConfirmButton.Parent then
        pcall(function()
            fireSignal(ConfirmButton.MouseButton1Click)
            fireSignal(ConfirmButton.Activated)
            ConfirmButton:CaptureFocus()
            ConfirmButton:ReleaseFocus(true)
        end)
        return true
    end
    
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if PlayerGui then
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local txt = (obj:IsA("TextButton") and obj.Text or ""):lower()
                if txt:find("submit") or txt:find("redeem") or txt:find("confirm") or txt:find("einlösen") then
                    pcall(function()
                        fireSignal(obj.MouseButton1Click)
                        fireSignal(obj.Activated)
                        obj:CaptureFocus()
                        obj:ReleaseFocus(true)
                    end)
                    return true
                end
            end
        end
    end
    
    return false
end

-- 11. HISTORY SPEICHERN
local function saveToHistory(Word, fromSammy)
    if not fromSammy then return end
    if not Word or Word == "" then return end
    if Word:find(" ") then return end
    
    local time = os.date("%H:%M:%S")
    table.insert(history, { word = Word, time = time, fromSammy = true })
    
    if #history > 100 then
        for i = 1, #history - 100 do
            table.remove(history, 1)
        end
    end
    
    if historyOpen and HistoryGui then
        updateHistoryContent()
    end
end

-- 12. CODE HINZUFÜGEN
local function addCode(Code, fromSammy)
    Code = tostring(Code)
    if Code == "" then return end
    
    if Code == lastAddedWord then
        return
    end
    lastAddedWord = Code
    task.delay(0.3, function() lastAddedWord = "" end)
    
    if fromSammy then
        saveToHistory(Code, true)
    end
    
    if not _G.ScriptEnabled or not _G.AutoWriteEnabled then return end
    if not CodeTextBox then setupPaths() end
    if not CodeTextBox then return end
    
    table.insert(collectedCodes, Code)
    refreshMainGUI()
    
    if CodeTextBox.Text == "" then
        CodeTextBox.Text = Code
    else
        CodeTextBox.Text = CodeTextBox.Text .. Code
    end
    AddedCount = AddedCount + 1
    
    if _G.AutoSubmitEnabled and #collectedCodes >= _G.SubmitAfterCount then
        local success = triggerSubmit()
        if success then
            task.wait(0.05)
            table.clear(collectedCodes)
            AddedCount = 0
            refreshMainGUI()
            if CodeTextBox then CodeTextBox.Text = "" end
        end
    end
end

-- 13. WATCHER
local function watchLabel(Label)
    if not Label:IsA("TextLabel") then return end
    local text = Label.Text
    if text == "" then return end
    
    if _G.RiddleSolverEnabled then
        local answer = answerQuestion(text)
        if answer then
            addCode(answer, true)
            return
        end
    end
    
    for word in text:gmatch("%S+") do
        addCode(word, true)
    end
end

