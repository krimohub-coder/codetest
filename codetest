local function updatePreview()
    setupPaths()
    if #buffer == 0 then
        if CodeTextBox then CodeTextBox.Text = "" end
        return
    end
    local count = math.min(#buffer, mode)
    local combined = table.concat(buffer, "", 1, count)
    if CodeTextBox then
        CodeTextBox.Text = combined
    end
end

local function hardReset()
    buffer = {}
    _seen = {}
    isProcessingSubmit = false
    
    setupPaths()
    if CodeTextBox then 
        pcall(function() CodeTextBox.Text = "" end)
    end
    
    updatePreview()
    updateTitleCounter()
    if refreshMainGUI then pcall(refreshMainGUI) end
    print("[GrimHub] 🔄 Hard Reset - Buffer geleert (0/" .. tostring(mode) .. ").")
end

local function hookTextBoxClearing()
    setupPaths()
    if CodeTextBox then
        CodeTextBox:GetPropertyChangedSignal("Text"):Connect(function()
            if CodeTextBox.Text == "" and #buffer > 0 then
                hardReset()
            end
        end)
    end
end
task.spawn(hookTextBoxClearing)

local function processBuffer()
    if not _G.ScriptEnabled or isProcessingSubmit then return end
    
    while #buffer >= mode do
        isProcessingSubmit = true
        local combined = table.concat(buffer, "", 1, mode)
        
        local success, msg = levithonTypeAndSubmit(combined)
        if success then
            print("[GrimHub] Redeemed: " .. combined)
        end
        
        task.wait(delay)
        hardReset()
        break
    end
    updatePreview()
    updateTitleCounter()
end

