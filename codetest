    if char and char:FindFirstChild("HumanoidRootPart") then
        HomePosition = char.HumanoidRootPart.Position
        StatusLabel.Text = "📍 Home gesetzt!"
    end
end

SetHomeBtn.MouseButton1Click:Connect(updateHome)

ToggleBtn.MouseButton1Click:Connect(function()
    ENABLED = not ENABLED
    if ENABLED then
        if not HomePosition then updateHome() end
        StatusDot.BackgroundColor3 = Color3.fromRGB(60, 220, 120)
        ToggleStroke.Color = Color3.fromRGB(80, 110, 240)
        StatusLabel.Text = "▶ Gestartet..."
    else
        StatusDot.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        ToggleStroke.Color = Color3.fromRGB(50, 60, 90)
        StatusLabel.Text = "⏹ Pausiert."
    end
end)

local function updateMinValFromBox()
    local val = parseFormattedNumber(ValueBox.Text)
    if val > 0 then
        MIN_INCOME = val
        StatusLabel.Text = "Min $/s: " .. tostring(ValueBox.Text)
    else
        ValueBox.Text = "100k"
        MIN_INCOME = 100000
    end
end

ValueBox.FocusLost:Connect(updateMinValFromBox)

-- HAUPTSCHLEIFE (SMOOTH & ANTI-FREEZE)
task.spawn(function()
    while true do
        task.wait(0.08) -- Sanfte Taktung, verhindert Freezes komplett

        if ENABLED and not isTargeting then
            local targetPos, income = scanRNGMachineOnly()

            if targetPos then
                isTargeting = true
                StatusLabel.Text = "⚡ Instant Buy (" .. tostring(math.floor(income/1000)) .. "k/s)..."
                
                -- Sofort aus der Ferne triggern (KEIN HINLAUFEN NOTWENDIG)
                local prompts = getBuyPromptsNear(targetPos)
                for _, buyPrompt in ipairs(prompts) do
                    triggerPrompt(buyPrompt)
                end

                task.wait(0.3)
                isTargeting = false
            else
                -- Spin mit gesetztem Delay
                if tick() - lastSpinTime >= SPIN_COOLDOWN then
                    local spinPrompt = getSpinPrompt()
                    if spinPrompt then
                        triggerPrompt(spinPrompt)
                        lastSpinTime = tick()
                    end
                end
            end
        end
    end
end)
