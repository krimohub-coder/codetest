-- ── Self Highlight ────────────────────────────────────────────────────────────

local highlightObj = nil
local highlightHue = 0

local function updateSelfHighlight()
    if settings.highlightEnabled and LocalPlayer.Character then
        if not highlightObj then
            highlightObj = Instance.new("Highlight")
            highlightObj.Adornee          = LocalPlayer.Character
            highlightObj.FillTransparency = 0.8
            highlightObj.OutlineTransparency = 0
            highlightObj.Parent           = LocalPlayer.Character
        end
    else
        if highlightObj then
            highlightObj:Destroy()
            highlightObj = nil
        end
    end
end

task.spawn(function()
    while true do
        if highlightObj then
            highlightHue = (highlightHue + 2) % 360
            local color = Color3.fromHSV(highlightHue / 360, 1, 1)
            highlightObj.OutlineColor = color
            highlightObj.FillColor    = color
        end
        task.wait(0.02)
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    if settings.highlightEnabled then
        if highlightObj then highlightObj:Destroy() end
        highlightObj = Instance.new("Highlight")
        highlightObj.Adornee          = char
        highlightObj.FillTransparency = 0.8
        highlightObj.OutlineTransparency = 0
        highlightObj.Parent           = char
    end
end)

-- ── TPWalk ────────────────────────────────────────────────────────────────────

local tpwalkConnection = nil
local tpwalkRoot       = nil

local function tpwalkMove()
    local char = LocalPlayer.Character
    if not char then tpwalkRoot = nil return end
    if not tpwalkRoot or tpwalkRoot.Parent ~= char then
        tpwalkRoot = char:FindFirstChild("HumanoidRootPart")
        if not tpwalkRoot then return end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local moveDir = hum.MoveDirection
    if moveDir.Magnitude <= 0 then return end
    moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
    if moveDir.Magnitude == 0 then return end
    moveDir = moveDir.Unit
    local speed = 25
    local delta = RunService.Heartbeat:Wait()
    tpwalkRoot.CFrame = tpwalkRoot.CFrame + moveDir * speed * delta
end

local function startTPWalk()
    if tpwalkConnection then tpwalkConnection:Disconnect() end
    tpwalkConnection = RunService.Heartbeat:Connect(tpwalkMove)
end

local function stopTPWalk()
    if tpwalkConnection then tpwalkConnection:Disconnect() tpwalkConnection = nil end
    tpwalkRoot = nil
end

-- ── Spin ──────────────────────────────────────────────────────────────────────

local spinConnection = nil
local spinRoot       = nil

local function spinCharacter()
    local char = LocalPlayer.Character
    if not char then spinRoot = nil return end
    if not spinRoot or spinRoot.Parent ~= char then
        spinRoot = char:FindFirstChild("HumanoidRootPart")
        if not spinRoot then return end
    end
    spinRoot.CFrame = spinRoot.CFrame * CFrame.Angles(0, math.rad(45), 0)
end

local function startSpin()
    if spinConnection then spinConnection:Disconnect() end
    spinConnection = RunService.Heartbeat:Connect(spinCharacter)
end

local function stopSpin()
    if spinConnection then spinConnection:Disconnect() spinConnection = nil end
    spinRoot = nil
end

