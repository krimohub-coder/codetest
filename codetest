-- 9. SUBMIT (FIXED - MIT VIRTUAL CLICK)
local function triggerSubmit()
    if submitCooldown then return false end
    submitCooldown = true
    task.delay(0.3, function() submitCooldown = false end)
    
    setupPaths()
    
    local success = false
    
    -- Versuch 1: Direct ConfirmButton mit CaptureFocus/ReleaseFocus
    if ConfirmButton then
        pcall(function()
            for i = 1, 3 do
                ConfirmButton:CaptureFocus()
                ConfirmButton:ReleaseFocus(true)
                task.wait(0.05)
            end
            success = true
        end)
        if success then return true end
    end
    
    -- Versuch 2: VirtualInputManager (falls verfügbar)
    if ConfirmButton then
        pcall(function()
            if VirtualInputManager then
                local buttonPos = ConfirmButton.AbsolutePosition
                local buttonSize = ConfirmButton.AbsoluteSize
                local x = buttonPos.X + buttonSize.X / 2
                local y = buttonPos.Y + buttonSize.Y / 2
                
                VirtualInputManager:SendMouseMoveEvent(x, y, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, "Left", 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, "Left", 0)
                success = true
            end
        end)
        if success then return true end
    end
    
    -- Versuch 3: MouseButton1Click Event feuern
    if ConfirmButton then
        pcall(function()
            local clickEvent = ConfirmButton:FindFirstChild("MouseButton1Click")
            if clickEvent then
                if getconnections then
                    for _, conn in ipairs(getconnections(clickEvent)) do
                        if conn and conn.Fire then 
                            conn:Fire()
                            success = true
                        end
                    end
                end
                if firesignal then
                    firesignal(clickEvent)
                    success = true
                end
            end
        end)
        if success then return true end
    end
    
    -- Versuch 4: Im gesamten PlayerGui nach Buttons suchen
    if PlayerGui then
        pcall(function()
            for _, obj in ipairs(PlayerGui:GetDescendants()) do
                if obj:IsA("TextButton") then
                    local txt = obj.Text:lower()
                    if txt:find("submit") or txt:find("redeem") or txt:find("confirm") or txt:find("einlösen") then
                        for i = 1, 3 do
                            obj:CaptureFocus()
                            obj:ReleaseFocus(true)
                            task.wait(0.05)
                        end
                        success = true
                        break
                    end
                end
            end
        end)
        if success then return true end
    end
    
    return false
end

-- 10. HISTORY SPEICHERN
local function saveToHistory(Word, fromSammy)
    if not _G.HistoryEnabled then return end
    if not fromSammy then return end
    if not Word or Word == "" then return end
    if Word:find(" ") then return end
    
    local time = os.date("%H:%M:%S")
    table.insert(history, { word = Word, time = time, fromSammy = true })
    
    if #history > 100 then
        for i = 1, #history - 100 do
            table.remove(history, 1)
        end
    end
    
    if historyOpen and HistoryGui then
        updateHistoryContent()
    end
end

-- 11. CODE HINZUFÜGEN (MIT SUBMIT ZUERST, DANN LÖSCHEN)
local function addCode(Code, fromSammy)
    Code = tostring(Code)
    if Code == "" then return end
    
    if Code == lastAddedWord then
        return
    end
    lastAddedWord = Code
    task.delay(0.3, function() lastAddedWord = "" end)
    
    if fromSammy then
        saveToHistory(Code, true)
    end
    
    if not _G.ScriptEnabled or not _G.AutoWriteEnabled then return end
    if not CodeTextBox then setupPaths() end
    if not CodeTextBox then return end
    
    table.insert(collectedCodes, Code)
    refreshMainGUI()
    
    if CodeTextBox.Text == "" then
        CodeTextBox.Text = Code
    else
        CodeTextBox.Text = CodeTextBox.Text .. Code
    end
    AddedCount = AddedCount + 1
    
    -- AUTO SUBMIT: ZUERST SUBMIT, DANN LÖSCHEN
    if _G.AutoSubmitEnabled and #collectedCodes >= _G.SubmitAfterCount then
        -- 1. ZUERST Submit ausführen
        local success = triggerSubmit()
        
        -- 2. Warten damit Submit durchgeführt werden kann
        task.wait(0.3)
        
        -- 3. DANACH Codes zurücksetzen
        table.clear(collectedCodes)
        AddedCount = 0
        refreshMainGUI()
        if CodeTextBox then CodeTextBox.Text = "" end
        
        if success then
            print("[KrimoHub] ✅ Codes erfolgreich eingelöst!")
        else
            print("[KrimoHub] ❌ Submit fehlgeschlagen! Codes wurden zurückgesetzt.")
        end
    end
end

-- 12. WATCHER
local function watchLabel(Label)
    pcall(function()
        if not Label:IsA("TextLabel") then return end
        local text = Label.Text
        if text == "" then return end
        
        if _G.RiddleSolverEnabled then
            local answer = answerQuestion(text)
            if answer then
                addCode(answer, true)
                return
            end
        end
        
        for word in text:gmatch("%S+") do
            addCode(word, true)
        end
    end)
end

local function startAnnouncementWatcher()
    pcall(function()
        setupPaths()
        if not Announcements then return end
        for _, v in ipairs(Announcements:GetDescendants()) do
            watchLabel(v)
        end
        Announcements.DescendantAdded:Connect(watchLabel)
    end)
end

