        obj:GetPropertyChangedSignal("Text"):Connect(function()
            local t=obj.Text or ""
            if isBigTop(obj) and (classify(obj) or extractWords(t) or isRiddle(t)) then
                if not _watched[obj] then watchLabel(obj) end
                processGlobal(t)
            end
        end)
    end
end)

