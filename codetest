local function loadConfig()
    if not hasFS then return end
    pcall(function()
        if isfile and isfile("GrimHub_config.json") then
            local data = HttpService:JSONDecode(readfile("GrimHub_config.json"))
            if type(data) == "table" then
                if data.guiColor then
                    _G.GuiColor = Color3.fromRGB(data.guiColor.r * 255, data.guiColor.g * 255, data.guiColor.b * 255)
                end
                if data.splitBuffer ~= nil then _G._splitBufferEnabled = data.splitBuffer end
                if data.autoSpam ~= nil then _G._autoSpam = data.autoSpam end
                if data.speedMode ~= nil then _G._speedMode = data.speedMode end
                if data.panelW ~= nil then _G.PANEL_W = data.panelW end
                if data.panelH ~= nil then _G.PANEL_H = data.panelH end
                if data.optimizer ~= nil then _G._optimizerEnabled = data.optimizer end
                if data.autoBuy ~= nil then settings.autoBuy = data.autoBuy end
                if data.anchor ~= nil then settings.anchor = data.anchor end
                if data.scanKeybind ~= nil then _G.keybindName = data.scanKeybind end
            end
        end
    end)
end

local function saveConfig()
    if not hasFS then return end
    pcall(function() 
        if writefile then 
            writefile("GrimHub_config.json", HttpService:JSONEncode({
                guiColor = {r = _G.GuiColor.R, g = _G.GuiColor.G, b = _G.GuiColor.B},
                splitBuffer = _G._splitBufferEnabled or false,
