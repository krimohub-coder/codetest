-- $/s Zahl-Erkennung
local function parseFormattedNumber(text)
    if not text or type(text) ~= "string" then return 0 end
    local lowerText = string.lower(text)

    local numStr, suffix = string.match(lowerText, "([%d%.,]+)%s*([kmbt]?)/s")
    if not numStr then
        if not string.find(lowerText, "%$") then
            numStr, suffix = string.match(lowerText, "([%d%.,]+)%s*([kmbt])")
        end
    end

    if not numStr then return 0 end

    numStr = string.gsub(numStr, ",", ".")
    local parts = string.split(numStr, ".")
    if #parts > 2 then
        local rawNum = ""
        for i = 1, #parts - 1 do rawNum = rawNum .. parts[i] end
        numStr = rawNum .. "." .. parts[#parts]
    end

    local num = tonumber(numStr) or 0

    if suffix == "k" then num = num * 1e3
    elseif suffix == "m" then num = num * 1e6
    elseif suffix == "b" then num = num * 1e9
    elseif suffix == "t" then num = num * 1e12
    end

    return num
end

-- Verbots-Filter (Sperrt Wheels, Upgrades & QUEEN BEE!)
local function isForbiddenPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return true end
    
    local actT = string.lower(prompt.ActionText or "")
    local objT = string.lower(prompt.ObjectText or "")
    local parentName = string.lower(prompt.Parent and prompt.Parent.Name or "")

    -- Sperrt Wheel & Upgrades
    if string.find(actT, "wheel") or string.find(objT, "wheel") or string.find(parentName, "wheel") then return true end
    if string.find(actT, "crystal") or string.find(objT, "crystal") or string.find(parentName, "crystal") then return true end
    if string.find(actT, "upgrade") or string.find(objT, "upgrade") or string.find(parentName, "upgrade") then return true end

    -- 🛑 QUEEN BEE SPERRE
    if string.find(actT, "queen") or string.find(objT, "queen") or string.find(parentName, "queen") then return true end
    if string.find(actT, "bee") or string.find(objT, "bee") or string.find(parentName, "bee") then return true end

    return false
end

-- Remote Trigger (Kauft ohne Bewegung aus der Distanz)
local function triggerPrompt(prompt)
    if isForbiddenPrompt(prompt) then return end

    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        end
    end)

    local inputs = { Enum.UserInputType.Keyboard, Enum.UserInputType.MouseButton1, Enum.UserInputType.Touch }
    for _, input in ipairs(inputs) do
        pcall(function()
            prompt:InputHoldBegin(input)
            prompt:InputHoldEnd(input)
        end)
    end
end

-- Spin Prompt Suche
local function getSpinPrompt()
    for _, prompt in pairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled and not isForbiddenPrompt(prompt) then
            local actT = string.lower(prompt.ActionText or "")
            local objT = string.lower(prompt.ObjectText or "")

            if string.find(actT, "spin") or string.find(objT, "spin") or string.find(actT, "again") then
                return prompt
            end
        end
    end
    return nil
end

-- Kauf-Prompts finden
local function getBuyPromptsNear(position)
    local buyPrompts = {}
    for _, prompt in pairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled and not isForbiddenPrompt(prompt) then
            local actT = string.lower(prompt.ActionText or "")
            local objT = string.lower(prompt.ObjectText or "")

            if not string.find(actT, "spin") and not string.find(objT, "spin") and not string.find(actT, "again") then
                local promptPart = prompt.Parent
                if promptPart:IsA("Attachment") then promptPart = promptPart.Parent end
                
                if promptPart and promptPart:IsA("BasePart") then
                    if (promptPart.Position - position).Magnitude <= 20 then
                        table.insert(buyPrompts, prompt)
                    end
                end
            end
        end
    end
    return buyPrompts
end

-- Scannt strikt RNG Machine
local function scanRNGMachineOnly()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local refPos = HomePosition or (hrp and hrp.Position)

    if not refPos then return nil, 0 end

    for _, gui in pairs(Workspace:GetDescendants()) do
        if gui:IsA("BillboardGui") or gui:IsA("SurfaceGui") then
            local adornee = gui.Adornee or gui.Parent
            if adornee and adornee:IsA("BasePart") then
                local dist = (adornee.Position - refPos).Magnitude
                
                if dist <= MAX_RNG_DISTANCE then
                    for _, txtObj in pairs(gui:GetDescendants()) do
                        if txtObj:IsA("TextLabel") and txtObj.Text and txtObj.Text ~= "" then
                            local fullText = string.lower(txtObj.Text)
                            if not string.find(fullText, "queen") and not string.find(fullText, "bee") then
                                local income = parseFormattedNumber(txtObj.Text)
                                if income >= MIN_INCOME then
                                    return adornee.Position, income
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return nil, 0
end

