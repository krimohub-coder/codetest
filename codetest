local function setupPaths()
    pcall(function()
        PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not PlayerGui then return end
        
        local codes = PlayerGui:FindFirstChild("Codes")
        if codes then
            local codesInner = codes:FindFirstChild("Codes")
            if codesInner then
                local codeRedeem = codesInner:FindFirstChild("CodeRedeem")
                if codeRedeem then
                    CodeTextBox = codeRedeem:FindFirstChild("TextBox")
                    ConfirmButton = codeRedeem:FindFirstChild("Confirm")
                end
            end
        end
        
        if not CodeTextBox or not ConfirmButton then
            for _, child in ipairs(PlayerGui:GetDescendants()) do
                if child:IsA("TextBox") and not CodeTextBox then
                    CodeTextBox = child
                elseif child:IsA("TextButton") and not ConfirmButton then
                    local txt = child.Text:lower()
                    if txt:find("confirm") or txt:find("redeem") or txt:find("submit") or txt:find("einlösen") then
                        ConfirmButton = child
                    end
                end
            end
        end
        
        local topNotif = PlayerGui:FindFirstChild("TopNotification")
        if topNotif then
            Announcements = topNotif:FindFirstChild("TopNotification")
        end
        if not Announcements then
            for _, child in ipairs(PlayerGui:GetDescendants()) do
                if child:IsA("Frame") and child.Name:lower():find("announce") then
                    Announcements = child
                    break
                end
            end
        end
    end)
end

