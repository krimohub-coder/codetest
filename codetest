local function clearPendingSubmission()
pendingRejectedToken = pendingRejectedToken + 1
pendingRejectedText = nil
pendingRejectedBox = nil
pendingRejectedUntil = 0
invalidCount = 0
lastRejectedCode = ""
end

local function rememberPendingSubmission(box, fullCodeText)
if not _G.RetypeInvalidEnabled then return end
if not fullCodeText or fullCodeText == "" then return end
pendingRejectedToken = pendingRejectedToken + 1
local token = pendingRejectedToken
pendingRejectedText = fullCodeText -- KOMPLETTER CODE
pendingRejectedBox = box
pendingRejectedUntil = os.clock() + 8
task.delay(8, function()
if token == pendingRejectedToken then
clearPendingSubmission()
end
end)
end

local function restoreRejectedText(box, previousText)
if not _G.RetypeInvalidEnabled then return false end
if not previousText or previousText == "" then return false end
RunService.Heartbeat:Wait()
local repasteBox = getAceCodeBox() or box
if not repasteBox or not isBoxVisible(repasteBox) then return false end
local restored = pcall(function()
repasteBox.Text = previousText -- KOMPLETTER CODE
end)
if restored then
table.clear(collectedCodes)
AddedCount = 0
refreshMainGUI()
if submitTimer then
task.cancel(submitTimer)
submitTimer = nil
end
end
return restored
end

local function handleRedemptionFeedback(text)
    if not _G.RetypeInvalidEnabled then return end
    if not pendingRejectedText then return end
    if os.clock() > pendingRejectedUntil then
        clearPendingSubmission()
        invalidCount = 0
        lastRejectedCode = ""
        return
    end

    local lower = tostring(text or ""):lower()
    local rejected = lower:find("invalid", 1, true)
        or lower:find("expired", 1, true)
        or lower:find("already redeemed", 1, true)
        or lower:find("already used", 1, true)
        or lower:find("doesn't exist", 1, true)
        or lower:find("does not exist", 1, true)
        or lower:find("not found", 1, true)
        or lower:find("rejected", 1, true)

    if not rejected then
        -- Kein Error mehr, Reset Counter und gespeicherten Code
        invalidCount = 0
        lastRejectedCode = ""
        clearPendingSubmission()
        return
    end

    local previousText = pendingRejectedText

    if previousText ~= lastRejectedCode then
        -- Neuer Code, Reset Counter
        invalidCount = 1
    else
        invalidCount = invalidCount + 1
    end

    lastRejectedCode = previousText

    local repasteBox = getAceCodeBox() or pendingRejectedBox
    if not repasteBox or not isBoxVisible(repasteBox) then
        clearPendingSubmission()
        invalidCount = 0
        lastRejectedCode = ""
        return
    end

    local newText = ""

    if repasteBox.Text == "" then
        -- Textbox leer, nur einmal hi
        newText = "hi"
        invalidCount = 1
    else
        if invalidCount == 1 then
            newText = "hi"
        elseif invalidCount == 2 then
            newText = "hihi"
        else
            newText = string.rep("hi", invalidCount)
        end
    end

    local success, err = pcall(function()
        repasteBox.Text = newText
    end)

    if success then
        table.clear(collectedCodes)
        AddedCount = 0
        refreshMainGUI()
        clearPendingSubmission()
    else
        clearPendingSubmission()
    end
end

