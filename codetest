local function resetSplitBuffer()
    currentCodeBuffer = ""
    _splitActive = false
    _lastSplitSubmit = 0
end

local function processSplitSnippet(snippet, typeAndSubmitCode)
    if not _splitBufferEnabled then return false end

    snippet = normalizeCode(snippet)
    if snippet == "" then return false end

    -- Wort zum Buffer hinzufügen (wie KrimoHub)
    currentCodeBuffer = currentCodeBuffer .. snippet
    local codeToTry = applyCase(currentCodeBuffer)

    if CodeTextBox then CodeTextBox.Text = currentCodeBuffer end
    print("[GrimHub] Split Buffer: " .. currentCodeBuffer)

    -- RESPECT COOLDOWN (wie KrimoHub)
    if tick() < _redeemCooldownUntil then
        return true
    end

    local now = tick()
    if now - _lastSplitSubmit < 0.15 then
        return true
    end
    _lastSplitSubmit = now

    -- SUBMIT! (wie KrimoHub - jedes Wort submitet den kompletten Buffer)
    if _autoSpam then
        print("[GrimHub] SPAM (3x): " .. codeToTry)
        task.spawn(function()
            local concurrent = 0
            local maxConcurrent = (_speedMode == "MAX") and 16 or 9
            local total = 3
            for i = 1, total do
                if tick() < _redeemCooldownUntil then break end
                while concurrent >= maxConcurrent do task.wait() end
                concurrent = concurrent + 1
                task.spawn(function()
                    if typeAndSubmitCode then typeAndSubmitCode(codeToTry) end
                    concurrent = concurrent - 1
                end)
                if i % 3 == 0 then task.wait() end
            end
            print("[GrimHub] Spam (3x) finished")
        end)
    else
        print("[GrimHub] Submitting: " .. codeToTry)
        task.spawn(function()
            local ok = typeAndSubmitCode and typeAndSubmitCode(codeToTry)
            if ok then
                print("[GrimHub] Redeemed: " .. codeToTry)
            else
                task.wait(0.15)
                if tick() >= _redeemCooldownUntil then
                    ok = typeAndSubmitCode and typeAndSubmitCode(codeToTry)
                    print(ok and ("[GrimHub] Redeemed: " .. codeToTry) or "[GrimHub] Failed to redeem")
                end
            end
        end)
    end

    return true
end

