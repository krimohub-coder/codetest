-- ==================== HELPERS ====================

local function normalizeText(text)
    if not text then return "" end
    text = text:gsub("<[^>]->", "")
    text = text:match("^%s*(.-)%s*$") or text
    text = string.lower(text)
    text = text:gsub("[^%w%s]", "")
    text = text:match("^%s*(.-)%s*$") or text
    return text
end

local function updateCounter()
    CounterText.Text = codesRedeemed .. "/" .. totalTarget
end

local function setMessageCount(n)
    messageCount = n
    totalTarget = n
    TextButton7.Text = "SELECT: " .. n .. " MESSAGE" .. (n > 1 and "S" or "") .. "  \226\150\188"
    updateCounter()
end

