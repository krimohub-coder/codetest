-- PERSISTENZ
local hasFS = pcall(function() return type(writefile) == "function" end)

local function loadConfig()
    if not hasFS then return end
    pcall(function()
        if isfile and isfile("KrimoHub_config.json") then
            local data = HttpService:JSONDecode(readfile("KrimoHub_config.json"))
            if type(data) == "table" and data.accentColor then
                _G.AccentColor = Color3.fromRGB(data.accentColor.r * 255, data.accentColor.g * 255, data.accentColor.b * 255)
            end
        end
    end)
end

local function saveConfig()
    if not hasFS then return end
    pcall(function() 
        if writefile then 
            writefile("KrimoHub_config.json", HttpService:JSONEncode({
                accentColor = {r = _G.AccentColor.R, g = _G.AccentColor.G, b = _G.AccentColor.B}
            })) 
        end
    end)
end
