        awToggle.BackgroundColor3 = _G.AutoWriteEnabled and Color3.fromRGB(34, 197, 94) or Color3.fromRGB(50, 50, 50)
        awToggle.Text = _G.AutoWriteEnabled and "ON" or "OFF"
        awToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
        awToggle.Font = Enum.Font.GothamBold
        awToggle.TextSize = 9
        awToggle.ZIndex = 10
        awToggle.Parent = ContentFrame
        do local co = Instance.new("UICorner") co.CornerRadius = UDim.new(0, 4) co.Parent = awToggle end
        
        awToggle.MouseButton1Click:Connect(function()
            _G.AutoWriteEnabled = not _G.AutoWriteEnabled
            awToggle.BackgroundColor3 = _G.AutoWriteEnabled and Color3.fromRGB(34, 197, 94) or Color3.fromRGB(50, 50, 50)
            awToggle.Text = _G.AutoWriteEnabled and "ON" or "OFF"
            if not _G.AutoWriteEnabled then hardReset() end
        end)
        
        -- Code Liste
        local codeListFrame = Instance.new("Frame")
        codeListFrame.Name = "CodeListFrame"
        codeListFrame.Size = UDim2.new(1, -20, 0, 68)
        codeListFrame.Position = UDim2.new(0, 10, 0, 142)
        codeListFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 22)
        codeListFrame.BackgroundTransparency = 0.3
        codeListFrame.ZIndex = 10
        codeListFrame.Parent = ContentFrame
        do local co = Instance.new("UICorner") co.CornerRadius = UDim.new(0, 4) co.Parent = codeListFrame end
        
        local scroll = Instance.new("ScrollingFrame")
        scroll.Name = "Scrolling"
        scroll.Size = UDim2.new(1, -4, 1, -4)
        scroll.Position = UDim2.new(0, 2, 0, 2)
        scroll.BackgroundTransparency = 1
        scroll.ZIndex = 11
        scroll.Parent = codeListFrame
        
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 2)
        layout.Parent = scroll
        
        local placeholder = Instance.new("TextLabel")
        placeholder.Name = "Placeholder"
        placeholder.Size = UDim2.new(1, 0, 0, 14)
        placeholder.BackgroundTransparency = 1
        placeholder.Text = "🌸 no codes yet"
        placeholder.TextColor3 = Color3.fromRGB(100, 160, 200)
        placeholder.Font = Enum.Font.Gotham
        placeholder.TextSize = 8
        placeholder.ZIndex = 12
        placeholder.Parent = scroll
        
        -- Drag Main GUI
        local dragging = false
        local dragStart = nil
        local startPos = nil
        
        MainFrame.InputBegan:Connect(function(input)
            if isMinimized then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = MainFrame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if isMinimized or not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        
        refreshMainGUI()
    end)
end

