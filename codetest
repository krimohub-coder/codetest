local _speedMode = "MAX"
local _redeemCooldownUntil = 0
local COOLDOWN_TIME = 2.8
local currentCodeBuffer = ""
local _splitActive = false
local _lastSplitSubmit = 0
local _caseMode = "EXACT"

local function normalizeCode(s)
    return (tostring(s or "")):match("^%s*(.-)%s*$") or ""
end

local function applyCase(s)
    s = tostring(s or "")
    if _caseMode == "UPPER" then return s:upper()
    elseif _caseMode == "lower" then return s:lower() end
    return s
end

local function resetSplitBuffer()
    currentCodeBuffer = ""
    _splitActive = false
    _lastSplitSubmit = 0
end

local function processSplitSnippet(snippet, typeAndSubmitCode)
    if not _splitBufferEnabled then return false end

    snippet = normalizeCode(snippet)
    if snippet == "" then return false end

    currentCodeBuffer = currentCodeBuffer .. snippet
    local codeToTry = applyCase(currentCodeBuffer)

    if CodeTextBox then CodeTextBox.Text = currentCodeBuffer end
    print("[KrimoHub] Split Buffer: " .. currentCodeBuffer)

    if tick() < _redeemCooldownUntil then
        return true
    end

    local now = tick()
    if now - _lastSplitSubmit < 0.15 then
        return true
    end
    _lastSplitSubmit = now

    if _autoSpam then
        print("[KrimoHub] SPAM (3x): " .. codeToTry)
        task.spawn(function()
            local concurrent = 0
            local maxConcurrent = (_speedMode == "MAX") and 16 or 9
            local total = 3
            for i = 1, total do
                if tick() < _redeemCooldownUntil then break end
                while concurrent >= maxConcurrent do task.wait() end
                concurrent = concurrent + 1
                task.spawn(function()
                    if typeAndSubmitCode then typeAndSubmitCode(codeToTry) end
                    concurrent = concurrent - 1
                end)
                if i % 3 == 0 then task.wait() end
            end
            print("[KrimoHub] Spam (3x) finished")
        end)
    else
        print("[KrimoHub] Submitting: " .. codeToTry)
        task.spawn(function()
            local ok = typeAndSubmitCode and typeAndSubmitCode(codeToTry)
            if ok then
                print("[KrimoHub] Redeemed: " .. codeToTry)
            else
                task.wait(0.15)
                if tick() >= _redeemCooldownUntil then
                    ok = typeAndSubmitCode and typeAndSubmitCode(codeToTry)
                    print(ok and ("[KrimoHub] Redeemed: " .. codeToTry) or "[KrimoHub] Failed to redeem")
                end
            end
        end)
    end

    return true
end

