-- 9. LOGIK & HELPER
local function triggerSubmit()
    if submitCooldown then return false end
    submitCooldown = true
    task.delay(0.3, function() submitCooldown = false end)
    setupPaths()
    if ConfirmButton then
        pcall(function() ConfirmButton:CaptureFocus() ConfirmButton:ReleaseFocus(true) end)
        return true
    end
    return false
end

local function saveToHistory(Word, fromSammy)
    if not _G.HistoryEnabled or not fromSammy or not Word or Word == "" or Word:find(" ") then return end
    table.insert(history, { word = Word, time = os.date("%H:%M:%S"), fromSammy = true })
    if #history > 100 then table.remove(history, 1) end
    if historyOpen and HistoryGui then updateHistoryContent() end
end

local function addCode(Code, fromSammy)
    Code = tostring(Code)
    if Code == "" or Code == lastAddedWord then return end
    lastAddedWord = Code
    task.delay(0.3, function() lastAddedWord = "" end)
    
    if fromSammy then saveToHistory(Code, true) end
    if not _G.ScriptEnabled or not _G.AutoWriteEnabled then return end
    if not CodeTextBox then setupPaths() end
    if not CodeTextBox then return end
    
    table.insert(collectedCodes, Code)
    refreshMainGUI()
    
    CodeTextBox.Text = CodeTextBox.Text .. Code
    AddedCount = AddedCount + 1
    
    if _G.AutoSubmitEnabled and #collectedCodes >= _G.SubmitAfterCount then
        triggerSubmit()
        table.clear(collectedCodes)
        AddedCount = 0
        refreshMainGUI()
        if CodeTextBox then CodeTextBox.Text = "" end
    end
end

local function watchLabel(Label)
    pcall(function()
        if not Label:IsA("TextLabel") or Label.Text == "" then return end
        if _G.RiddleSolverEnabled then
            local answer = answerQuestion(Label.Text)
            if answer then addCode(answer, true) return end
        end
        for word in Label.Text:gmatch("%S+") do addCode(word, true) end
    end)
end

local function startAnnouncementWatcher()
    pcall(function()
        setupPaths()
        if not Announcements then return end
        for _, v in ipairs(Announcements:GetDescendants()) do watchLabel(v) end
        Announcements.DescendantAdded:Connect(watchLabel)
    end)
end

local function resetCodes()
    table.clear(collectedCodes)
    AddedCount = 0
    lastAddedWord = ""
    refreshMainGUI()
    if CodeTextBox then CodeTextBox.Text = "" end
end

local function verifySourceIsSammy(TO)
    pcall(function()
        if TO:IsDescendantOf(MainFrame) or (HistoryGui and TO:IsDescendantOf(HistoryGui)) then return false end
        if (TO.Text or ""):lower():find("spydersammy") then return true end
    end)
    return false
end

local function handleIncomingText(TO)
    pcall(function()
        if TO.Text ~= "" and verifySourceIsSammy(TO) then
            task.spawn(function() watchLabel(TO) end)
        end
    end)
end

local function hookUiTextObject(O)
    pcall(function()
        if O:IsA("TextLabel") then
            handleIncomingText(O)
            O:GetPropertyChangedSignal("Text"):Connect(function() handleIncomingText(O) end)
        end
    end)
end

local function startPlayerGuiScanner()
    pcall(function()
        local PG = LocalPlayer:FindFirstChild("PlayerGui")
        if not PG then return end
        for _, D in ipairs(PG:GetDescendants()) do hookUiTextObject(D) end
        PG.DescendantAdded:Connect(hookUiTextObject)
    end)
end

