-- 8. GEFIXTE AUTO-SUBMIT LOGIK
local function triggerSubmit()
    if submitCooldown then return false end
    submitCooldown = true
    task.delay(0.2, function() submitCooldown = false end)
    
    setupPaths()
    
    if _delay > 0 then
        task.wait(_delay)
    end
    
    local submitted = false
    
    -- Option A: RemoteEvent / RemoteFunction Triggering
    pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local name = obj.Name:lower()
                if name:find("redeem") or name:find("code") or name:find("submit") then
                    if obj:IsA("RemoteEvent") then
                        obj:FireServer(CodeTextBox and CodeTextBox.Text or "")
                        submitted = true
                    end
                end
            end
        end
    end)
    
    -- Option B: Return Key Event Simulation
    if CodeTextBox then
        pcall(function()
            CodeTextBox:CaptureFocus()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
            CodeTextBox:ReleaseFocus(true)
            submitted = true
        end)
    end
    
    -- Option C: Confirm Button Connections Trigger
    if ConfirmButton then
        pcall(function()
            for _, conn in ipairs(getconnections(ConfirmButton.MouseButton1Click or ConfirmButton.Activated)) do
                conn:Fire()
            end
            submitted = true
        end)
    end
    
    return submitted
end

-- 9. CODE HINZUFÜGEN & HISTORY
local function saveToHistory(Word, fromSammy)
    if not _G.HistoryEnabled or not fromSammy or not Word or Word == "" then return end
    if Word:find(" ") then return end
    
    local time = os.date("%H:%M:%S")
    table.insert(history, { word = Word, time = time, fromSammy = true })
    
    if #history > 100 then
        table.remove(history, 1)
    end
end

local function addCode(Code, fromSammy)
    Code = tostring(Code)
    if Code == "" then return end
    
    if Code == lastAddedWord then return end
    lastAddedWord = Code
    task.delay(0.3, function() lastAddedWord = "" end)
    
    if fromSammy then
        saveToHistory(Code, true)
    end
    
    if not _G.ScriptEnabled or not _G.AutoWriteEnabled then return end
    if not CodeTextBox then setupPaths() end
    if not CodeTextBox then return end
    
    table.insert(collectedCodes, Code)
    
    if CodeTextBox.Text == "" then
        CodeTextBox.Text = Code
    else
        CodeTextBox.Text = CodeTextBox.Text .. Code
    end
    
    AddedCount = AddedCount + 1
    refreshMainGUI()
    
    -- AUTO-SUBMIT TRIGGER BEI ERREICHTER ANZAHL
    if _G.AutoSubmitEnabled and #collectedCodes >= _G.SubmitAfterCount then
        triggerSubmit()
        
        table.clear(collectedCodes)
        AddedCount = 0
        
        if CodeTextBox then 
            CodeTextBox.Text = "" 
        end
        refreshMainGUI()
    end
end

-- 10. WATCHER & DETECTORS
local function watchLabel(Label)
    pcall(function()
        if not Label:IsA("TextLabel") then return end
        local text = Label.Text
        if text == "" then return end
        
        if _G.RiddleSolverEnabled then
            local answer = answerQuestion(text)
            if answer then
                addCode(answer, true)
                return
            end
        end
        
        for word in text:gmatch("%S+") do
            addCode(word, true)
        end
    end)
end

local function verifySourceIsSammy(TO)
    pcall(function()
        if TO:IsDescendantOf(MainFrame) then return false end
        local text = TO.Text or ""
        if text:lower():find("spydersammy") then return true end
        
        local parent = TO.Parent
        while parent do
            if parent:IsA("TextLabel") and parent.Text and parent.Text:lower():find("spydersammy") then
                return true
            end
            parent = parent.Parent
        end
    end)
    return false
end

local function handleIncomingText(TO)
    pcall(function()
        if TO.Text ~= "" and verifySourceIsSammy(TO) then
            task.spawn(function() watchLabel(TO) end)
        end
    end)
end

local function hookUiTextObject(O)
    pcall(function()
        if O:IsA("TextLabel") then
            handleIncomingText(O)
            O:GetPropertyChangedSignal("Text"):Connect(function()
                handleIncomingText(O)
            end)
        end
    end)
end

local function startPlayerGuiScanner()
    pcall(function()
        local PG = LocalPlayer:FindFirstChild("PlayerGui")
        if not PG then return end
        for _, D in ipairs(PG:GetDescendants()) do
            hookUiTextObject(D)
        end
        PG.DescendantAdded:Connect(hookUiTextObject)
    end)
end

local function startAnnouncementWatcher()
    pcall(function()
        setupPaths()
        if not Announcements then return end
        for _, v in ipairs(Announcements:GetDescendants()) do
            watchLabel(v)
        end
        Announcements.DescendantAdded:Connect(watchLabel)
    end)
end

local function resetCodes()
    table.clear(collectedCodes)
    AddedCount = 0
    lastAddedWord = ""
    refreshMainGUI()
    if CodeTextBox then CodeTextBox.Text = "" end
end
