local function answerQuestion(text)
    if not _G.RiddleSolverEnabled or not text or text == "" then return nil end
    local clean = text:lower():gsub("[%?%.%,!']", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if SLURP_DB[clean] then return SLURP_DB[clean] end
    
    local bestMatch = nil
    local maxMatchLength = 0
    for key, value in pairs(SLURP_DB) do
        if clean:find(key, 1, true) and #key > maxMatchLength then
            maxMatchLength = #key
            bestMatch = value
        end
    end
    return bestMatch
end

