local function isOwnGui(obj)
    local p = obj
    for i=1,10 do
        if not p then break end
        if p.Name == "KrimoHubGui" or p.Name == "KrimoSettingsTest" or p.Name == "KrimoHelpGui" then
            return true
        end
        p = p.Parent
    end
    return false
end

local function isGuiVisible(guiObj)
    if not guiObj then return false end
    local p = guiObj
    while p do
        if p:IsA("GuiObject") and not p.Visible then return false end
        if p:IsA("ScreenGui") then return p.Enabled end
        p = p.Parent
    end
    return true
end

local function getCodeBoxes(pg)
    local boxes = {}
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOwnGui(g) then
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextBox") and not isOwnGui(d) then table.insert(boxes, d) end
            end
        end
    end
    return boxes
end

local function findSubmitButtons(pg)
    local btns = {}
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOwnGui(g) then
            for _, d in ipairs(g:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOwnGui(d) then
                    local n = d.Name:lower()
                    local pn = (d.Parent and d.Parent.Name or ""):lower()
                    if (n:find("code") or n:find("redeem") or pn:find("code") or pn:find("redeem")) and isGuiVisible(d) then
                        table.insert(btns, d)
                    end
                end
            end
        end
    end
    return btns
end

local function clickButton(btn)
    if not btn then return false end
    pcall(function() btn.MouseButton1Click:Fire() end)
    pcall(function() btn.Activated:Fire() end)
    if typeof(firesignal) == "function" then
        pcall(firesignal, btn.MouseButton1Click)
        pcall(firesignal, btn.Activated)
    end
    return true
end

local function fireFocusLost(box)
    if not box then return false end
    if typeof(firesignal) == "function" then pcall(firesignal, box.FocusLost, true) end
    return true
end

local function findCodeBox()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local all = getCodeBoxes(pg)
    for _, b in ipairs(all) do
        if isGuiVisible(b) then return b end
    end
    return nil
end

local function submitCode(code)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false, "no PlayerGui" end
    
    local box = findCodeBox()
    if box then
        pcall(function() box.Text = code end)
        task.wait(0.05)
        local btns = findSubmitButtons(pg)
        for _, b in ipairs(btns) do clickButton(b) end
        fireFocusLost(box)
        return true, "submitted"
    end
    return false, "no box found"
end

-- ============================================================
-- STATE & WATCHER (GEFIXTER COUNTER LOGIK)
-- ============================================================

local _msgBuffer = {}
local _seen = {}
local isProcessingSubmit = false
local collectedCodes = {}
local refreshMainGUI

local function appendToBox(text)
    if not text or text == "" then return end
    if not _G.ScriptEnabled or not _G.AutoWriteEnabled or isProcessingSubmit then return end
    
    if _seen[text] then return end
    _seen[text] = true
    task.delay(2, function() _seen[text] = nil end)
    
    -- Riddle Solver
    if _G.RiddleSolverEnabled then
        local answer = answerQuestion(text)
        if answer then
            local box = findCodeBox()
            if box then
                pcall(function() box.Text = answer end)
                if _G.AutoSubmitEnabled then submitCode(answer) end
            end
            return
        end
    end

    -- Füge Code hinzu
    table.insert(_msgBuffer, text)
    table.insert(collectedCodes, text)
    
    local combinedCode = table.concat(_msgBuffer)
    local box = findCodeBox()
    if box then
        pcall(function() box.Text = combinedCode end)
    end
    
    -- Aktualisiere GUI & Anzeige
    if refreshMainGUI then refreshMainGUI() end

    -- SUBMIT CONDITION (0/3 -> 3/3 Submit)
    if #collectedCodes >= _G.SubmitAfterCount then
        isProcessingSubmit = true
        
        task.spawn(function()
            if _G.AutoSubmitEnabled then
                submitCode(combinedCode)
            end
            
            -- RESET NACH SUBMIT
            task.wait(0.5)
            _msgBuffer = {}
            collectedCodes = {}
            if refreshMainGUI then refreshMainGUI() end
            isProcessingSubmit = false
        end)
    end
end

-- WATCHER & SCANNER
local ToggleButton = nil
local Announcements = nil

local function watchLabel(Label)
    if not Label:IsA("TextLabel") then return end
    local text = Label.Text
    if text ~= "" then appendToBox(text) end
end

local function startAnnouncementWatcher()
    pcall(function()
        local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not PlayerGui then return end
        for _, child in ipairs(PlayerGui:GetDescendants()) do
            if child:IsA("TextLabel") then
                child:GetPropertyChangedSignal("Text"):Connect(function()
                    watchLabel(child)
                end)
            end
        end
        PlayerGui.DescendantAdded:Connect(function(O)
            if O:IsA("TextLabel") then
                O:GetPropertyChangedSignal("Text"):Connect(function() watchLabel(O) end)
            end
        end)
    end)
end

