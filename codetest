local snipeConnection = nil

local function startSniping()
    isSniping = true
    StatusIndicator.BackgroundColor3 = Color3.fromRGB(80, 220, 80)
    UIStroke5.Color = Color3.fromRGB(80, 220, 80)
    StartPillBtn.Text = "STOP"
    StartPillBtn.TextColor3 = Color3.fromRGB(180, 40, 40)
    UIStroke3.Color = Color3.fromRGB(215, 100, 100)
    TextButton8.Text = "STOP SNIPING"
    codesRedeemed = 0
    updateCounter()

    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local codesFolder = rs:FindFirstChild("Codes")
        if codesFolder then
            for _, child in pairs(codesFolder:GetChildren()) do
                if child:IsA("RemoteEvent") then
                    snipeConnection = child.OnClientEvent:Connect(function(code)
                        if not isSniping then return end
                        if codesRedeemed >= totalTarget then return end
                        pcall(function()
                            local redeemRemote = codesFolder:FindFirstChild("CodeRedeem")
                            if redeemRemote and redeemRemote:IsA("RemoteEvent") then
                                redeemRemote:FireServer(tostring(code))
                            end
                        end)
                        codesRedeemed = codesRedeemed + 1
                        updateCounter()
                        if codesRedeemed >= totalTarget then
                            stopSniping()
                        end
                    end)
                    break
                end
            end
        end
    end)
end

function stopSniping()
    isSniping = false
    StatusIndicator.BackgroundColor3 = Color3.fromRGB(240, 80, 80)
    UIStroke5.Color = Color3.fromRGB(240, 80, 80)
    StartPillBtn.Text = "START"
    StartPillBtn.TextColor3 = Color3.fromRGB(35, 125, 75)
    UIStroke3.Color = Color3.fromRGB(150, 215, 180)
    TextButton8.Text = "START SNIPING"
    if snipeConnection then
        pcall(function() snipeConnection:Disconnect() end)
        snipeConnection = nil
    end
end

-- ==================== AUTO RIDDLE WATCHER ====================

local function setupRiddleWatcher()
    PlayerGui.DescendantAdded:Connect(function(desc)
        if not isAutoRiddle then return end
        task.defer(function()
            if not desc or not desc.Parent then return end
            local text = ""
            pcall(function() text = desc.Text end)
            if text == "" then return end
            local normalized = normalizeText(text)
            local answer = riddleAnswers[normalized]
            if answer then
                local parent = desc.Parent
                if not parent then return end
                for _, sibling in pairs(parent:GetChildren()) do
                    if sibling:IsA("TextBox") then
                        sibling.Text = answer
                        task.wait(0.08)
                        for _, btn in pairs(parent:GetChildren()) do
                            if btn:IsA("GuiButton") then
                                pcall(function() btn.Activated:Fire() end)
                                break
                            end
                        end
                        break
                    end
                end
            end
        end)
    end)
end

pcall(setupRiddleWatcher)

