    for run = 1, loops do
        local cg = pg:FindFirstChild("Codes")
        if cg then
            if cg:IsA("ScreenGui") then cg.Enabled = true end
            local cf = cg:FindFirstChild("Codes") or cg
            if cf then
                if cf:IsA("GuiObject") then cf.Visible = true end
                local cur = cf
                while cur and cur ~= cg do 
                    if cur:IsA("GuiObject") then cur.Visible = true end 
                    cur = cur.Parent 
                end
                
                local box = nil
                for _, d in ipairs(cf:GetDescendants()) do 
                    if d:IsA("TextBox") and not isOurGui(d) then box = d; break end 
                end
                
                local btn = nil
                for _, d in ipairs(cf:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                        local n = d.Name:lower()
                        local t = ""
                        pcall(function() t = d.Text:lower() end)
                        if n:find("submit") or t:find("submit") or n:find("redeem") or t:find("redeem") or n:find("claim") or n:find("confirm") or n:find("enter") then 
                            btn = d; break 
                        end
                    end
                end
                if not btn then
                    for _, d in ipairs(cf:GetDescendants()) do
                        if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                            local n = d.Name:lower()
                            if not n:find("close") and not n:find("x") and not n:find("toggle") then btn = d; break end
                        end
                    end
                end
                if box then
                    pcall(function() box.Text = code end)
                    task.wait(0.05)
                    if btn then fireButtonClick(btn) end
                    fireFocusLostSignal(box)
                    if loops == 1 then return true, "submitted" end
                end
            end
        end

        local btns = findCodeButtons(pg)
        for _, b in ipairs(btns) do fireButtonClick(b) task.wait(0.05) end
        task.wait(0.1)

        local box = nil
        local deadline = tick() + 1
        while tick() < deadline do
            local all = findAllTextBoxes(pg)
            for _, d in ipairs(all) do
                if isVisibleChain(d) then
                    local n = d.Name:lower()
                    local pn = (d.Parent and d.Parent.Name or ""):lower()
                    if n:find("code") or pn:find("code") or n:find("redeem") or pn:find("redeem") or n:find("input") or pn:find("textbox") or n:find("enter") then 
                        box = d; break 
                    end
                end
            end
            if not box then 
                for _, d in ipairs(all) do if isVisibleChain(d) then box = d; break end end 
            end
            if box then break end
            task.wait(0.05)
        end

        if box then
            pcall(function() box.Text = code end)
            task.wait(0.05)

            local btn = nil
            local names = {"submit","redeem","claim","confirm","enter","send","apply","ok","use","go","check"}
            local p = box.Parent
            for i = 1, 8 do
                if not p then break end
                for _, d in ipairs(p:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) and d ~= box then
                        local n = d.Name:lower()
                        local t = ""
                        pcall(function() t = d.Text:lower() end)
                        for _, sn in ipairs(names) do
                            if n:find(sn) or t:find(sn) then
                                if isVisibleChain(d) then btn = d; break end
                            end
                        end
                        if btn then break end
                    end
                end
                if btn then break end
                p = p.Parent
            end

            if btn then fireButtonClick(btn) end
            fireFocusLostSignal(box)
        end
        if loops > 1 then task.wait(0.05) end
    end
    return true, "submitted"
end

