local Announcements = nil
local CodeTextBox = nil
local SubmitButton = nil
local PlayerGui = nil

local function setupPaths()
    pcall(function()
        PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not PlayerGui then return end
        
        local codes = PlayerGui:FindFirstChild("Codes")
        if codes then
            local codesInner = codes:FindFirstChild("Codes")
            if codesInner then
                local codeRedeem = codesInner:FindFirstChild("CodeRedeem")
                if codeRedeem then
                    CodeTextBox = codeRedeem:FindFirstChild("TextBox")
                    for _, child in ipairs(codeRedeem:GetDescendants()) do
                        if child:IsA("TextButton") then
                            local txt = child.Text:upper()
                            if txt:find("SEND") or txt:find("SUBMIT") or txt:find("REDEEM") or txt:find("CONFIRM") then
                                SubmitButton = child
                                break
                            end
                        end
                    end
                    if not SubmitButton then
                        for _, child in ipairs(codeRedeem:GetDescendants()) do
                            if child:IsA("TextButton") then
                                SubmitButton = child
                                break
                            end
                        end
                    end
                end
            end
        end
        
        if not CodeTextBox or not SubmitButton then
            for _, child in ipairs(PlayerGui:GetDescendants()) do
                if child:IsA("TextBox") and not CodeTextBox then
                    CodeTextBox = child
                elseif child:IsA("TextButton") and not SubmitButton then
                    local txt = child.Text:upper()
                    if txt:find("SEND") or txt:find("SUBMIT") or txt:find("REDEEM") or txt:find("CONFIRM") then
                        SubmitButton = child
                    end
                end
            end
        end
        
        local topNotif = PlayerGui:FindFirstChild("TopNotification")
        if topNotif then
            Announcements = topNotif:FindFirstChild("TopNotification")
        end
        if not Announcements then
            for _, child in ipairs(PlayerGui:GetDescendants()) do
                if child:IsA("Frame") and child.Name:lower():find("announce") then
                    Announcements = child
                    break
                end
            end
        end
    end)
end

