local SUBMIT_KW={"submit","redeem","confirm","claim","enter","apply","ok","go"}
local function isSubmitButton(o)
    if not (o:IsA("TextButton") or o:IsA("ImageButton")) then return false end
    local n=(o.Name or ""):lower()
    local t=(o:IsA("TextButton") and (o.Text or "") or ""):lower()
    for _,k in ipairs(SUBMIT_KW) do
        if n:find(k,1,true) or t:find(k,1,true) then return true end
    end
    return false
end

local function findSubmitButton(box)
    if not box or not box.Parent then return nil end
    local scopes={box.Parent, box.Parent.Parent, box.Parent.Parent and box.Parent.Parent.Parent}
    for _,scope in ipairs(scopes) do
        if scope then
            local ok,desc=pcall(function() return scope:GetDescendants() end)
            if ok then
                for _,d in ipairs(desc) do
                    if isSubmitButton(d) then return d end
                end
            end
        end
    end
    return nil
end

local function clickButton(btn)
    if not btn then return false end
    local ok=pcall(function()
        if typeof(firesignal)=="function" then
            firesignal(btn.MouseButton1Click)
        elseif typeof(getconnections)=="function" then
            for _,c in ipairs(getconnections(btn.MouseButton1Click)) do
                pcall(function() c:Fire() end)
            end
        else
            btn.MouseButton1Click:Fire()
        end
    end)
    return ok
end

local function appendToBox(text)
    if not text or text=="" then return end
    if not _focused or not _focused.Parent then
        setStatus("Click the code box first!",T.Yellow)
        flashCode(text, T.Yellow)
        return
    end
    local cur=_focused.Text or ""
    if cur=="" then
        _focused.Text=text
    else
        _focused.Text=cur.." "..text
    end
    flashCode(text,T.Green)
    if not _autoSubmit then
        setStatus("Appended!",T.Green)
        return
    end
    local box=_focused
    task.spawn(function()
        task.wait(0.15)
        local btn=findSubmitButton(box)
        if btn and clickButton(btn) then
            setStatus("Submitted!",T.Green)
        else
            setStatus("Appended! (no submit button found)",T.Green)
        end
    end)
end

local RIDDLE_KW={
    "when was","how old","what year","what month","birthday","age of",
    "released","release date","hint","riddle","figure out","guess",
    "first letter","combine","spell","backwards","months","years",
